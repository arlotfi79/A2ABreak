{
 "states": [
  "WaitForConnection",
  "AUTHORIZATION",
  "TRANSACTION",
  "UPDATE"
 ],
 "initial_state": "WaitForConnection",
 "final_states": [
  "UPDATE"
 ],
 "transitions": [
  {
   "from": "WaitForConnection",
   "event": "send greeting",
   "action": "reply +OK POP3 server ready",
   "to": "AUTHORIZATION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "cond valid USER/PASS",
   "action": "set authenticated true",
   "to": "TRANSACTION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "cond valid APOP",
   "action": "set authenticated true",
   "to": "TRANSACTION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "receive APOP failure",
   "action": "send -ERR response",
   "to": "AUTHORIZATION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "receive USER",
   "action": "reply request password",
   "to": "AUTHORIZATION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "cond open maildrop failed",
   "action": "reply -ERR and release lock",
   "to": "AUTHORIZATION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "cond auth failed retry",
   "action": "issue new authentication command",
   "to": "AUTHORIZATION"
  },
  {
   "from": "AUTHORIZATION",
   "event": "receive QUIT",
   "action": "reply +OK and close TCP",
   "to": "WaitForConnection"
  },
  {
   "from": "AUTHORIZATION",
   "event": "cond auth failure close",
   "action": "release lock; send -ERR response; close connection",
   "to": "WaitForConnection"
  },
  {
   "from": "TRANSACTION",
   "event": "receive QUIT",
   "action": "set session closing",
   "to": "UPDATE"
  },
  {
   "from": "TRANSACTION",
   "event": "receive STAT",
   "action": "reply message count size",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive LIST",
   "action": "reply scan listing",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive RETR",
   "action": "reply full message",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive DELE",
   "action": "set message deleted",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive NOOP",
   "action": "reply OK",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive RSET",
   "action": "reset deleted flags",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive TOP",
   "action": "send headers and body lines",
   "to": "TRANSACTION"
  },
  {
   "from": "TRANSACTION",
   "event": "receive UIDL",
   "action": "send unique-id listing",
   "to": "TRANSACTION"
  },
  {
   "from": "UPDATE",
   "event": "cond update complete",
   "action": "remove deleted messages; release maildrop lock; send goodbye response; close TCP connection",
   "to": "WaitForConnection"
  },
  {
   "from": "TRANSACTION",
   "event": "cond abnormal termination",
   "action": "retain all messages; close TCP connection",
   "to": "WaitForConnection"
  }
 ]
}