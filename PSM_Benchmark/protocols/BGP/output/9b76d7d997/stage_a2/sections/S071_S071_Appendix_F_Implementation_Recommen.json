      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "When peering with a BGP implementation that does not compress multiple address prefixes into one message, it may be necessary to take steps to reduce the overhead from the flood of data received when a peer is acquired or when a significant network topology change occurs.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S071",
      "actors": [
        "BGP speaker",
        "peer"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "may",
      "id": "N-S071-002"
    },
    {
      "statement_id": "N-S071-3",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "By choosing a minimum flash update interval that is not much greater than the time it takes to process the multiple messages, this latency should be minimized.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S071",
      "actors": [
        "BGP speaker"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "should",
      "id": "N-S071-003"
    },
    {
      "statement_id": "N-S071-4",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "To avoid excessive route flapping, a BGP speaker that needs to withdraw a destination and send an update about a more specific or less specific route should combine them into the same UPDATE message.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S071",
      "actors": [
        "BGP speaker"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "should",
      "id": "N-S071-004"
    },
    {
      "statement_id": "N-S071-5",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "Implementations that combine update messages (as described above in Section 6.1) may prefer to see all path attributes presented in a known order.",
