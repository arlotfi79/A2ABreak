      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "Because BGP-4 is capable of carrying aggregated routes that cannot be properly represented in BGP-3, an implementation that supports BGP-4 and another BGP version should provide the capability to only speak BGP-4 on a per-peer basis.",
      "is_inferred": false,
      "confidence": 1.0,
