      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "An implementation that chooses to provide a path aggregation algorithm retaining significant amounts of path information may wish to use the following procedure:",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S071",
      "actors": [
