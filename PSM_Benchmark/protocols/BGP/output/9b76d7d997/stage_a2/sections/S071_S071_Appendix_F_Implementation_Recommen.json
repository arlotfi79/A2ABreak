      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "bgp",
      "stage": "bgp_fsm",
      "description": "If, as a result of the above procedure, a given AS number appears more than once within the aggregated AS_PATH attribute, all but the last instance (rightmost occurrence) of that AS number should be removed from the aggregated AS_PATH attribute.",
      "is_inferred": false,
      "confidence": 1.0,
