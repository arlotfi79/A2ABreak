      "actors": [
        "BGP speaker",
        "peers"
      ],
      "from_state": "Established",
      "to_state": null,
      "trigger": "local_policy_change",
      "pre_cond": "connection.state = Established & local_policy_change_detected = true",
      "post_cond": "connection.reset_required = false",
      "actions": [
        "retain current version of routes advertised by all peers for duration of connection",
        "OR invoke Route Refresh extension per RFC2918"
      ],
