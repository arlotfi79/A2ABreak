      "from_state": "authenticated",
      "to_state": "authenticated",
      "trigger": "ENABLE_received_with_supported_argument",
      "pre_cond": "extension.supported_by_server = true & extension.requires_enabling = true",
      "post_cond": "extension.enabled = true & extension.active_until_connection_close = true",
      "actions": [
        "enable extension",
        "maintain extension enabled until connection closed"
