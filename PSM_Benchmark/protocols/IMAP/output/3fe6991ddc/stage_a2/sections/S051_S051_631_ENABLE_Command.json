      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "imap_fsm",
      "description": "If the argument is an extension that is supported by the server and that needs to be enabled, the server MUST enable the extension for the duration of the connection.",
