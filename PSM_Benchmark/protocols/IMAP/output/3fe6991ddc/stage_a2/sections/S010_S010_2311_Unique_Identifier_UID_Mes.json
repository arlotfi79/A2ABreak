      "to_state": null,
      "trigger": null,
      "pre_cond": "new_message.added = false & uidvalidity.changed = false",
      "post_cond": "uidnext.unchanged = true",
      "actions": [],
      "modality": "must",
      "id": "N-S010-006"
    },
