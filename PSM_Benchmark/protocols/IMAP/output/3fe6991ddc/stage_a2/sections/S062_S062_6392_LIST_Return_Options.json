      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "imap_fsm",
      "description": "Furthermore, all other mailbox attributes MUST be accurately computed (this differs from the behavior of the obsolete LSUB command from [RFC3501]).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S062",
      "actors": [
