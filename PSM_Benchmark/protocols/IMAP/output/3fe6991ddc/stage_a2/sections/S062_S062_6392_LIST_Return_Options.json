    {
      "statement_id": "N-S062-3",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "imap_fsm",
      "description": "For each selectable mailbox matching the list pattern and selection options, the server MUST return an untagged LIST response followed by an untagged STATUS response containing the information requested in the STATUS return option, except for some cases described below.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S062",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "LIST_command_with_STATUS_return_option",
      "pre_cond": "LIST.return_option = STATUS & mailbox.selectable = true",
      "post_cond": "LIST_response.sent = true & STATUS_response.sent = true",
      "actions": [
        "send untagged LIST response",
        "send untagged STATUS response with requested data items"
      ],
      "modality": "must",
      "id": "N-S062-003"
    },
    {
      "statement_id": "N-S062-4",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "imap_fsm",
      "description": "If an attempted STATUS for a listed mailbox fails because the mailbox can't be selected (e.g., if the \"l\" Access Control List (ACL) right [RFC4314] is granted to the mailbox and the \"r\" right is not granted, or is due to a race condition between LIST and STATUS changing the mailbox to \\NoSelect), the STATUS response MUST NOT be returned, and the LIST response MUST include the \\NoSelect attribute.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S062",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "STATUS_lookup_failed_mailbox_not_selectable",
      "pre_cond": "STATUS.lookup_failed = true & mailbox.selectable = false",
      "post_cond": "STATUS_response.sent = false & LIST_response.NoSelect_attribute = true",
      "actions": [
        "omit STATUS response",
        "include \\NoSelect attribute in LIST response"
      ],
      "modality": "must",
      "id": "N-S062-004"
    },
