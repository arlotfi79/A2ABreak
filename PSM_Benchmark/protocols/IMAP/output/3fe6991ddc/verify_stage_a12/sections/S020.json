        "allowed_values": null,
        "guard_semantics": null,
        "from_state": {
          "was": "Authenticated",
          "should_be": "Selected",
          "reason": "A mailbox select error occurs when trying to select a mailbox from the Selected (or possibly Authenticated) state; the from_state should reflect the state prior to the failed SELECT attempt, which is Selected or Authenticated. However, the spec says this state (Authenticated) is entered after an error in selecting a mailbox, implying the attempt was made from a state where SELECT was issued — most naturally Selected or Authenticated. The from_state 'Authenticated' is plausible but the transition is from whichever state the SELECT was attempted; RFC 3501 implies SELECT can be issued from Authenticated or Selected, so from_state could be either. The most precise correction is that from_state should be 'Authenticated or Selected' since SELECT can be issued from both."
        },
        "to_state": null,
        "trigger": null,
        "pre_cond": {
          "was": "session.state = Authenticated & mailbox.select_error = true",
          "should_be": "session.state IN {Authenticated, Selected} & mailbox.select_error = true",
          "reason": "SELECT can be issued from both Authenticated and Selected states, so the pre_cond should reflect both possibilities."
        },
