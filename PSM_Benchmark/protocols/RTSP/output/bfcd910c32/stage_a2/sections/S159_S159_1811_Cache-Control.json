      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "Therefore, if a response includes the no-transform directive, an intermediate cache or proxy MUST NOT change the encoding of the stream or response.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S159",
      "actors": [
