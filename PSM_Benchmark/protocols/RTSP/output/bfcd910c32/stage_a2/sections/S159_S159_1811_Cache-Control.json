      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "If the cache receives this directive, it SHOULD either respond using a cached media stream or response that is consistent with the other constraints of the request or respond with a 504 (Gateway Timeout) status.",
