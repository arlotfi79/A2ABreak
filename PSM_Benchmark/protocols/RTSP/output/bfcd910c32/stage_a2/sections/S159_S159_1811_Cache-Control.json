      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "Indicates that the media stream or RTSP response MUST NOT be cached anywhere.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S159",
