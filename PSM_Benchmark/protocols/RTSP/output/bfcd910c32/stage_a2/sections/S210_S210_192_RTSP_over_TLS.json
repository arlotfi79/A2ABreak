      "statement_id": "5-S210-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "When a client tries to set up an insecure channel to the server (using the \"rtsp\" URI), and the policy for the resource requires a secure channel, the server MUST redirect the client to the secure service by sending a 301 redirect response code together with the correct Location URI (using the \"rtsps\" scheme).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S210",
      "actors": [
        "server",
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "client_requests_insecure_channel",
      "pre_cond": "request.scheme = rtsp & resource.policy = secure_required",
      "post_cond": "response.code = 301 & response.Location.scheme = rtsps",
      "actions": [
        "send 301 redirect response",
        "include Location URI using rtsps scheme"
      ],
      "modality": "must",
      "id": "N-S210-005"
    },
    {
      "statement_id": "6-S210-6",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "A user or client MAY upgrade a non secured URI to a secured by changing the scheme from \"rtsp\" to \"rtsps\".",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S210",
      "actors": [
        "user",
        "client"
