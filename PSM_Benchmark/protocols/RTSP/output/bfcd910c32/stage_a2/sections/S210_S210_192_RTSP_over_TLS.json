      ],
      "from_state": null,
      "to_state": null,
      "trigger": "client_upgrades_uri_scheme_to_rtsps",
      "pre_cond": "server.supports_rtsps = true & request.scheme = rtsps",
      "post_cond": null,
      "actions": [
