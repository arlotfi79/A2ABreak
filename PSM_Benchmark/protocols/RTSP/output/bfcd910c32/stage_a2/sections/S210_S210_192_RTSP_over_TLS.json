      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "rtsp_fsm",
      "description": "In that case, the RTSP agent having the TCP/TLS connection MUST verify that the server certificate associated with the connection has a SubjectAltName matching the hostname present in the URI for the resource an RTSP request is to be issued.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S210",
      "actors": [
