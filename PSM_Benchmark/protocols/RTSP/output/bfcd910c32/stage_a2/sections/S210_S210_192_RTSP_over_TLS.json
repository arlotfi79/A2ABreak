      "from_state": null,
      "to_state": null,
      "trigger": "client_upgrades_uri_scheme",
      "pre_cond": "uri.scheme = rtsp",
      "post_cond": "uri.scheme = rtsps",
      "actions": [
        "change URI scheme from rtsp to rtsps"
      ],
      "modality": "may",
      "id": "N-S210-006"
    },
