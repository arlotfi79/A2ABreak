      "from_state": null,
      "to_state": null,
      "trigger": "reuse_tcp_tls_connection_for_different_hostname",
      "pre_cond": "connection.reuse = true & uri.hostname != connection.original_hostname",
      "post_cond": "certificate.SubjectAltName = uri.hostname",
      "actions": [
        "verify server certificate SubjectAltName matches hostname in request URI"
