    {
      "statement_id": "N-S212-1",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "With \"any\", the proxy (or proxies) MUST accept whatever certificate is presented.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "accept_credentials_header.received & accept_credentials.method = \"Any\"",
      "pre_cond": "accept_credentials.method = \"Any\"",
      "post_cond": "certificate.accepted = true",
      "actions": [
        "accept_certificate"
      ],
      "modality": "must",
      "id": "N-S212-001"
    },
    {
      "statement_id": "N-S212-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "For the \"proxy\" method, the proxy (or proxies) MUST use its own policies to validate the certificate and decide whether or not to accept it.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "accept_credentials.method = \"Proxy\"",
      "pre_cond": "accept_credentials.method = \"Proxy\"",
      "post_cond": null,
      "actions": [
        "apply_proxy_certificate_validation_policy"
      ],
      "modality": "must",
      "id": "N-S212-002"
    },
    {
      "statement_id": "N-S212-3",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "For the \"user\" method, the proxy (or proxies) MUST send credential information about the next hop to the client for authorization.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "proxy",
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "accept_credentials.method = \"User\"",
      "pre_cond": "accept_credentials.method = \"User\"",
      "post_cond": "credential_info.sent_to_client = true",
      "actions": [
        "send_next_hop_credential_info_to_client"
      ],
      "modality": "must",
      "id": "N-S212-003"
    },
    {
      "statement_id": "N-S212-4",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the Accept-Credentials header is not included in the RTSP request from the client, then the \"Proxy\" method MUST be used as default.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "proxy",
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "accept_credentials_header.present = false",
      "pre_cond": "accept_credentials_header.present = false",
      "post_cond": "accept_credentials.method = \"Proxy\"",
      "actions": [
        "set_default_method_to_Proxy"
      ],
      "modality": "must",
      "id": "N-S212-004"
    },
    {
      "statement_id": "N-S212-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "If a method other than the \"Proxy\" is to be used, then the Accept-Credentials header MUST be included in all of the RTSP requests from the client.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "accept_credentials.method != \"Proxy\"",
      "pre_cond": "accept_credentials.method != \"Proxy\"",
      "post_cond": "request.contains_accept_credentials_header = true",
      "actions": [
        "include_accept_credentials_header_in_all_requests"
      ],
      "modality": "must",
      "id": "N-S212-005"
    },
    {
      "statement_id": "N-S212-6",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the policy does not accept the credentials of the next hop, the proxy MUST respond with a message using status code 471 (Connection Credentials Not Accepted).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "policy.accepts_next_hop_credentials = false",
      "pre_cond": "(accept_credentials.method = \"Any\" | accept_credentials.method = \"Proxy\") & policy.accepts_next_hop_credentials = false",
      "post_cond": "response.status_code = 471",
      "actions": [
        "send_471_Connection_Credentials_Not_Accepted"
      ],
      "modality": "must",
      "id": "N-S212-006"
    },
    {
      "statement_id": "N-S212-7",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "An RTSP request in the direction server to client MUST NOT include the Accept-Credentials header.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "request.direction = server_to_client",
      "post_cond": "request.contains_accept_credentials_header = false",
      "actions": [
        "omit_accept_credentials_header_from_s2c_request"
      ],
      "modality": "must",
      "id": "N-S212-007"
    },
    {
      "statement_id": "N-S212-8",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "However, if the server-to-client request is in relation to a session established over a TLS secured channel, it MUST be sent in a TLS secured connection.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "server_to_client_request_send & session.established_over_tls = true",
      "pre_cond": "request.direction = server_to_client & session.established_over_tls = true",
      "post_cond": "request.transport = TLS_secured",
      "actions": [
        "send_s2c_request_over_tls_connection"
      ],
      "modality": "must",
      "id": "N-S212-008"
    },
    {
      "statement_id": "N-S212-9",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "connection",
      "stage": "rtsp_fsm",
      "description": "That secured connection MUST also be the one used by the last client-to-server request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "server_to_client_request_send & request.transport = TLS_secured",
      "pre_cond": "request.direction = server_to_client & request.transport = TLS_secured",
      "post_cond": "s2c_request.connection = last_c2s_request.connection",
      "actions": [
        "use_last_c2s_tls_connection_for_s2c_request"
      ],
      "modality": "must",
      "id": "N-S212-009"
    },
    {
      "statement_id": "N-S212-10",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If no such transport connection exists at the time when the server desires to send the request, the server MUST discard the message.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S212",
      "actors": [
