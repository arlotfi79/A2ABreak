  "statements": [
    {
      "statement_id": "1-S073-1",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "To minimize impact on playback in any of the above cases, the server MUST modify the playback properties, set scale to a supportable value, and continue delivery of the media.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S073",
      "actors": [
        "server",
        "client"
      ],
      "from_state": "Playing",
      "to_state": "Playing",
      "trigger": "scale_cannot_be_maintained",
      "pre_cond": "server.scale_maintainable = false",
      "post_cond": "server.scale = supportable_value & media_delivery.active = true",
      "actions": [
        "modify_playback_properties",
        "set_scale_to_supportable_value",
        "continue_media_delivery"
      ],
      "modality": "must",
      "id": "N-S073-001"
    },
    {
      "statement_id": "2-S073-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "When doing this modification, it MUST send a PLAY_NOTIFY message with the Notify-Reason header set to \"scale-change\".",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S073",
      "actors": [
        "server",
        "client"
      ],
      "from_state": "Playing",
      "to_state": "Playing",
      "trigger": "scale_change_forced",
      "pre_cond": "server.playback_modification_performed = true",
      "post_cond": "PLAY_NOTIFY.sent = true & PLAY_NOTIFY.Notify-Reason = scale-change",
      "actions": [
        "send_PLAY_NOTIFY(Notify-Reason=scale-change)"
      ],
      "modality": "must",
      "id": "N-S073-002"
    },
    {
      "statement_id": "3-S073-3",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "The request MUST contain a Range header with the media time when the change took effect, a Scale header with the new value in use, a Session header with the identifier for the session to which it applies, and a Date header with the server wallclock time of the change.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S073",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S073-003"
    },
    {
      "statement_id": "4-S073-4",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "For time-progressing content, the Media-Range and the Media-Properties headers at this point in time also MUST be included.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S073",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S073-004"
    },
    {
      "statement_id": "5-S073-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "The Media-Properties header MUST be included if the scale change was due to the content changing what scale values (\"Scales\") are supported.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S073",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S073-005"
    },
    {
