      "statement_id": "2-S222-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If a single server supports multiple organizations that do not trust each another, then it MUST check the values of the Content-Location header fields in responses that are generated under control of said organizations to make sure that they do not attempt to invalidate resources over which they have no authority (see Section 15.4 of [RFC2616]).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S222",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "response_generated",
      "pre_cond": "server.supports_multiple_organizations = true",
      "post_cond": "response.Content-Location.authority_validated = true",
      "actions": [
        "validate_Content-Location_header_authority"
      ],
      "modality": "must",
      "id": "N-S222-002"
    },
    {
      "statement_id": "3-S222-3",
      "normative_level": "SHALL",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "To mitigate this, the server SHALL use a large, random and non-sequential session identifier to minimize the possibility of this kind of attack.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S222",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "session_creation",
      "pre_cond": null,
      "post_cond": "session.identifier.entropy = high & session.identifier.sequential = false",
      "actions": [
        "generate_large_random_non_sequential_session_identifier"
      ],
      "modality": "shall",
      "id": "N-S222-003"
    },
