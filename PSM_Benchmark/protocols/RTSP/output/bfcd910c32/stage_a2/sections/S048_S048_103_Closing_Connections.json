      "source_section": "S048",
      "actors": [
        "server"
      ],
      "from_state": "open",
      "to_state": null,
      "trigger": "teardown_response_sent",
      "pre_cond": "session.is_last = true & teardown_response.sent = true",
      "post_cond": "connection.state != closed",
      "actions": [],
