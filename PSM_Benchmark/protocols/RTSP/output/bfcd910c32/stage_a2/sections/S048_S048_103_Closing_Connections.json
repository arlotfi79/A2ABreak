      "confidence": 1.0,
      "source_section": "S048",
      "actors": [
        "server"
      ],
      "from_state": "open",
      "to_state": "closed",
      "trigger": "teardown_response_sent",
      "pre_cond": "session.is_last = true & teardown_response.sent = true",
      "post_cond": "timer.elapsed >= 10 & connection.state = closed",
      "actions": [
        "start 10-second wait timer after TEARDOWN response",
        "close connection after timer expiry"
      ],
      "modality": "should",
      "id": "N-S048-004"
