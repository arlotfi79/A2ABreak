      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "The client MAY close a connection at any point when no outstanding request/response transactions exist for any RTSP session being managed through the connection.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S048",
      "actors": [
        "client"
      ],
      "from_state": "open",
      "to_state": "closed",
      "trigger": "client_initiates_close",
      "pre_cond": "connection.outstanding_transactions = 0",
      "post_cond": "connection.state = closed",
      "actions": [
        "close connection"
      ],
      "modality": "may",
      "id": "N-S048-001"
    },
    {
      "statement_id": "N-S048-2",
      "normative_level": "SHOULD NOT",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "The server, however, SHOULD NOT close a connection until all RTSP sessions being managed through the connection have been timed out (Section 18.49).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S048",
      "actors": [
        "server"
      ],
      "from_state": "open",
      "to_state": null,
      "trigger": "server_initiates_close",
      "pre_cond": "session.all_timed_out = false",
      "post_cond": "connection.state != closed",
      "actions": [],
      "modality": "should",
      "id": "N-S048-002"
    },
