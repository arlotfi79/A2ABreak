      "trigger": "PLAY_request_received_with_continuation_range",
      "pre_cond": "session.state = Play & range_specifier.start = implicit & range_specifier.stop = explicit",
      "post_cond": "active_range = (X to Z)",
      "actions": [
        "convert active range specifier from (X to Y) to (X to Z)",
        "continue playback as if (X to Z) was the originally requested range"
