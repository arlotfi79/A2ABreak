      "trigger": "receive_request_with_unsupported_Require_feature_tag",
      "pre_cond": "request.Require.feature_tag.supported = false",
      "post_cond": "response.status_code = 551 & response.Unsupported.contains(unsupported_feature_tags) = true",
      "actions": [
