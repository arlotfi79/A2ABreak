  "statements": [
    {
      "statement_id": "N-S193-1",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "For streams using RTP as transport protocol, the RTP-Info header SHOULD be part of a 200 response to PLAY.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": "Play",
      "trigger": "PLAY_response_200",
      "pre_cond": "transport.protocol = RTP",
      "post_cond": "response.contains(RTP-Info)",
      "actions": [
        "include RTP-Info header in 200 PLAY response"
      ],
      "modality": "should",
      "id": "N-S193-001"
    },
    {
      "statement_id": "N-S193-2",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "The RTP-Info MAY be included in SETUP responses to provide synchronization information when changing transport parameters, see Section 13.3.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "SETUP_request_received",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "optionally include RTP-Info in SETUP response"
      ],
      "modality": "may",
      "id": "N-S193-002"
    },
    {
      "statement_id": "N-S193-3",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "The RTP-Info header and the Range header MAY be included in a GET_PARAMETER request from client to server without any values to request the current playback point and corresponding RTP synchronization information.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [
        "client",
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "GET_PARAMETER_request_sent",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "optionally include RTP-Info header without values in GET_PARAMETER request",
        "optionally include Range header without values in GET_PARAMETER request"
      ],
      "modality": "may",
      "id": "N-S193-003"
    },
    {
      "statement_id": "N-S193-4",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "When the RTP-Info header is included in a Request, the Range header MUST also be included.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "request.contains(RTP-Info)",
      "post_cond": "request.contains(Range)",
      "actions": [
        "include Range header in request whenever RTP-Info header is present"
      ],
      "modality": "must",
      "id": "N-S193-004"
    },
    {
      "statement_id": "N-S193-5",
      "normative_level": "SHALL",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "The server response SHALL include both the Range header and the RTP-Info header.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "GET_PARAMETER_request_with_RTP-Info_received",
      "pre_cond": "request.contains(RTP-Info)",
      "post_cond": "response.contains(Range) & response.contains(RTP-Info)",
      "actions": [
        "include Range header in response",
        "include RTP-Info header in response"
      ],
      "modality": "shall",
      "id": "N-S193-005"
    },
    {
      "statement_id": "N-S193-6",
      "normative_level": "SHALL",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the session is in Play state, then the value of the Range header SHALL be filled in with the current playback point and with the corresponding RTP-Info values.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S193",
      "actors": [
        "server",
        "session"
      ],
      "from_state": "Play",
      "to_state": null,
      "trigger": "GET_PARAMETER_request_with_RTP-Info_received",
      "pre_cond": "session.state = Play",
      "post_cond": "response.Range.value = current_playback_point & response.RTP-Info.values = current_RTP_sync_info",
      "actions": [
        "fill Range header value with current playback point",
        "fill RTP-Info header with current RTP synchronization values"
      ],
      "modality": "shall",
      "id": "N-S193-006"
    },
