      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "rtsp_fsm",
      "description": "An RTSP message, sent by either the client or the server, containing a body MUST include a Date header, if the sending host has a clock;",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S169",
