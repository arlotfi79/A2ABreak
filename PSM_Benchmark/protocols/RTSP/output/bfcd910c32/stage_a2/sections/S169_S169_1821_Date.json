      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "In this case, this rule MUST be followed: some origin-server implementations might not have a clock available.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S169",
      "actors": [
        "server"
