      "statement_id": "5-S169-5",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "An origin server without a clock MUST NOT assign Expires or Last-Modified values to a response, unless these values were associated with the resource by a system or user with a reliable clock.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S169",
