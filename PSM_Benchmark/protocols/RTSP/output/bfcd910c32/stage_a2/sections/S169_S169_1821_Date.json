      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "It MAY assign an Expires value that is known, at or before server-configuration time, to be in the past (this allows \"pre-expiration\" of responses without storing separate Expires values for each resource).",
      "is_inferred": false,
      "confidence": 1.0,
