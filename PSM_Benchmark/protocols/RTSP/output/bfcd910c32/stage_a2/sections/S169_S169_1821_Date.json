      "statement_id": "3-S169-3",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the server does not have a clock that can provide a reasonable approximation of the current time, its responses MUST NOT include a Date header field.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S169",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
