      "normative_level": "RECOMMENDED",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "Clients and servers are RECOMMENDED to include a Date header in all other RTSP messages, if the sending host has a clock;",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S169",
      "actors": [
        "client",
        "server"
      ],
      "from_state": null,
