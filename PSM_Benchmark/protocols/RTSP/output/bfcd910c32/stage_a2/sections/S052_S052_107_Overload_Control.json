      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "rtsp_fsm",
      "description": "For addresses where no response was received or TCP timeout occurred, an initial wait timer SHOULD be set to 5 seconds.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S052",
      "actors": [
        "client",
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "tcp_timeout | no_response_received",
      "pre_cond": "timer.iteration = 0",
      "post_cond": "timer.mean_value = 5",
      "actions": [
        "initialise_wait_timer_to_5_seconds"
      ],
      "modality": "should",
      "id": "N-S052-004"
    },
    {
      "statement_id": "N-S052-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "rtsp_fsm",
      "description": "That timer MUST be doubled for each additional failure to connect or receive response until the value exceeds 30 minutes when the timer's mean value may be set to 30 minutes.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S052",
      "actors": [
        "client",
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "additional_connect_failure | additional_no_response",
      "pre_cond": "timer.mean_value <= 1800",
      "post_cond": "timer.mean_value = min(timer.mean_value * 2, 1800)",
      "actions": [
        "double_wait_timer_mean_value",
        "cap_timer_mean_at_1800_seconds_when_exceeded"
      ],
      "modality": "must",
      "id": "N-S052-005"
    },
    {
      "statement_id": "N-S052-6",
      "normative_level": "REQUIRED",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "rtsp_fsm",
      "description": "It is REQUIRED not to set the same value in the timer for each scheduling, but instead to add a variation to the mean value, resulting in picking a random value within the range of 0.5 to 1.5 times the mean value.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S052",
      "actors": [
        "client",
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "timer_scheduled",
      "pre_cond": "timer.mean_value != null",
      "post_cond": "timer.actual_value >= timer.mean_value * 0.5 & timer.actual_value <= timer.mean_value * 1.5",
      "actions": [
        "randomise_timer_actual_value_within_0.5_to_1.5_of_mean"
      ],
      "modality": "must",
