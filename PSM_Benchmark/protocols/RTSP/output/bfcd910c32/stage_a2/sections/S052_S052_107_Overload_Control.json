      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "rtsp_fsm",
      "description": "Any additional request to a specific address MUST be delayed according to the Retry-After headers received.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S052",
      "actors": [
        "client",
        "proxy"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "503_or_553_response_received_with_Retry_After",
      "pre_cond": "(response.code = 503 | response.code = 553) & response.header.Retry_After != null",
      "post_cond": "next_request.send_time >= current_time + Retry_After.value",
      "actions": [
        "delay_outgoing_request_by_Retry_After_value"
      ],
      "modality": "must",
      "id": "N-S052-003"
    },
    {
