      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the receiver of the request does not support the media type used for the message body, it SHALL respond using the error code 415 (Unsupported Media Type).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S078",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "GET_PARAMETER_request_received",
      "pre_cond": "server.media_type_supported = false",
      "post_cond": "response.status_code = 415",
      "actions": [
        "send 415 Unsupported Media Type response"
      ],
      "modality": "shall",
      "id": "N-S078-003"
    },
