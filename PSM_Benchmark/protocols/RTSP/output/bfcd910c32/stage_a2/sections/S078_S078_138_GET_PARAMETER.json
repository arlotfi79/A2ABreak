      "confidence": 1.0,
      "source_section": "S078",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "GET_PARAMETER_request_received",
      "pre_cond": null,
      "post_cond": "response.media_type = request.media_type",
      "actions": [
        "set response Content-Type to match request Content-Type"
      ],
      "modality": "must",
      "id": "N-S078-004"
    },
