      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the Session header is present in a request, the value of a parameter MUST be retrieved in the specified session context.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S078",
      "actors": [
        "server",
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "GET_PARAMETER_request_received",
      "pre_cond": "request.Session_header.present = true",
      "post_cond": "parameter.retrieval_context = session.specified",
      "actions": [
        "retrieve parameter value within the session context identified by the Session header"
      ],
      "modality": "must",
      "id": "N-S078-001"
    },
    {
