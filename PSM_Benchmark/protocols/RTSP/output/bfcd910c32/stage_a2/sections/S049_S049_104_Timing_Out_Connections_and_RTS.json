      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "requester"
      ],
      "from_state": "waiting_for_response",
      "to_state": null,
      "trigger": null,
      "pre_cond": "elapsed_time < 10s",
      "post_cond": null,
      "actions": [
        "continue_waiting_for_response"
      ],
      "modality": "should",
      "id": "N-S049-007"
    },
    {
      "statement_id": "N-S049-8",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "After receiving a 100 response, the requester SHOULD continue waiting for further responses.",
