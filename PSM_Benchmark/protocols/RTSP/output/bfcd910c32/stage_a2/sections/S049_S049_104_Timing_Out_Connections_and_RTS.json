      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "Receivers of a request (responders) SHOULD respond to requests in a timely manner even when a reliable transport such as TCP is used.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
