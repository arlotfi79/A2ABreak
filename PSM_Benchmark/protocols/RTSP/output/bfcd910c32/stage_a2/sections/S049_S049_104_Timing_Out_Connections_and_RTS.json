    },
    {
      "statement_id": "N-S049-2",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "Similarly, the sender of a request (requester) SHOULD wait for a sufficient time for a response before concluding that the responder will not be acting upon its request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "requester"
      ],
      "from_state": "waiting_for_response",
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "wait_sufficient_time_for_response"
      ],
      "modality": "should",
      "id": "N-S049-002"
    },
    {
      "statement_id": "N-S049-3",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "A responder SHOULD respond to all requests within 5 seconds.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "responder"
      ],
      "from_state": "processing_request",
      "to_state": null,
      "trigger": "request_received",
      "pre_cond": null,
      "post_cond": "response_sent",
      "actions": [
        "send_response_within_5_seconds"
      ],
      "modality": "should",
      "id": "N-S049-003"
    },
    {
      "statement_id": "N-S049-4",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "If the responder recognizes that the processing of a request will take longer than 5 seconds, it SHOULD send a 100 (Continue) response as soon as possible.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "responder"
      ],
      "from_state": "processing_request",
      "to_state": null,
      "trigger": "processing_exceeds_5_seconds",
      "pre_cond": "processing_time > 5s",
      "post_cond": "100_response_sent = true",
      "actions": [
        "send_100_continue_immediately"
      ],
      "modality": "should",
      "id": "N-S049-004"
    },
    {
      "statement_id": "N-S049-5",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "It SHOULD continue sending a 100 response every 5 seconds thereafter until it is ready to send the final response to the requester.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "responder"
      ],
      "from_state": "processing_request",
      "to_state": null,
      "trigger": "5_second_timer_expiry",
      "pre_cond": "100_response_sent = true & final_response_ready = false",
      "post_cond": null,
      "actions": [
        "send_100_continue",
        "restart_5_second_timer"
      ],
      "modality": "should",
      "id": "N-S049-005"
    },
    {
      "statement_id": "N-S049-6",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "After sending a 100 response, the responder MUST send a final response indicating the success or failure of the request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S049",
      "actors": [
        "responder"
      ],
      "from_state": "processing_request",
      "to_state": null,
      "trigger": "final_response_ready",
      "pre_cond": "100_response_sent = true",
      "post_cond": "final_response_sent = true",
      "actions": [
        "send_final_response"
      ],
      "modality": "must",
      "id": "N-S049-006"
    },
    {
      "statement_id": "N-S049-7",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "A requester SHOULD wait at least 10 seconds for a response before concluding that the responder will not be responding to its request.",
