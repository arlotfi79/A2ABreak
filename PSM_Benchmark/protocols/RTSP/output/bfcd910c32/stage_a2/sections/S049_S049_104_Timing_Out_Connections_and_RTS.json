      "pre_cond": null,
      "post_cond": "requester.waiting_for_final_response = true",
      "actions": [
        "continue_waiting_for_further_responses"
      ],
      "modality": "should",
      "id": "N-S049-008"
    },
    {
      "statement_id": "N-S049-9",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "rtsp_fsm",
      "description": "If more than 10 seconds elapse without receiving any response, the requester MAY assume that the responder is unresponsive and abort the connection by closing the TCP connection.",
