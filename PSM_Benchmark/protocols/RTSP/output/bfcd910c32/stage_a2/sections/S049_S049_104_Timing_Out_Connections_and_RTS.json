      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "rtsp_fsm",
      "description": "the RTSP client or server SHOULD establish a new connection and send any requests that are queued up or that haven't received a response on this new connection.",
