      "from_state": "waiting_for_response",
      "to_state": "connection_closed",
      "trigger": "10_second_timeout_no_response",
      "pre_cond": "elapsed_time > 10s & response_received = false",
      "post_cond": "connection.state = closed",
      "actions": [
        "assume_responder_unresponsive",
        "close_TCP_connection"
      ],
      "modality": "may",
      "id": "N-S049-009"
    },
    {
