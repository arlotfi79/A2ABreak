      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "rtsp_fsm",
      "description": "When responding to any request that contained the Pipelined-Requests header, the server MUST also include the Session header when a binding to a session context exists.",
