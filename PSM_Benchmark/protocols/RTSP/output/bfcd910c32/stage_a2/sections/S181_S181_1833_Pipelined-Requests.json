      "from_state": null,
      "to_state": null,
      "trigger": "request_received_with_both_Session_and_Pipelined-Requests_headers",
      "pre_cond": "request.Session_header.present = true & request.Pipelined-Requests_header.present = true",
      "post_cond": null,
      "actions": [
        "ignore_Pipelined-Requests_header"
      ],
      "modality": "must",
      "id": "N-S181-004"
    },
    {
