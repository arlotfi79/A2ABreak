      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "Upon receiving a request with the Pipelined-Requests, the responding agent MUST look up if there exists a binding between this Pipelined-Requests identifier for the current persistent connection and an RTSP session ID.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S181",
      "actors": [
        "responding agent"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "request_received_with_Pipelined-Requests_header",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "lookup_binding(Pipelined-Requests_identifier, persistent_connection, RTSP_session_ID)"
      ],
      "modality": "must",
      "id": "N-S181-001"
    },
    {
      "statement_id": "N-S181-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "If there does not exist a mapping and no Session header is included in the request, the responding agent MUST create a binding upon the successful completion of a session creating request, i.e., SETUP.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S181",
      "actors": [
        "responding agent"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "SETUP_completed_successfully",
      "pre_cond": "binding.exists = false & request.Session_header.present = false",
      "post_cond": "binding.created = true",
      "actions": [
        "create_binding(Pipelined-Requests_identifier, session_ID)"
      ],
      "modality": "must",
      "id": "N-S181-002"
    },
    {
      "statement_id": "N-S181-3",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "rtsp_fsm",
      "description": "A binding MUST NOT be created, if the request failed to create an RTSP session.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S181",
      "actors": [
        "responding agent"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "session_creation_failed",
      "pre_cond": "session.creation_failed = true",
