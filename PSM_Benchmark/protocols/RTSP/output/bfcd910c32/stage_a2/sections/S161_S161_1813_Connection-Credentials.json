      "stage": "rtsp_fsm",
      "description": "The Connection-Credentials header in an RTSP response MUST, if included, contain the credential information (in the form of a list of certificates providing the chain of certification) of the next hop to which an intermediary needs to securely connect.",
      "is_inferred": false,
      "confidence": 1.0,
