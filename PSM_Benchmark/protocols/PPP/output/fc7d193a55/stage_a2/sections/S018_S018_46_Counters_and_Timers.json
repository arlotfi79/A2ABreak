      "post_cond": null,
      "actions": [
        "configure Restart timer for faster retransmission times on high-speed or low-latency links"
      ],
      "modality": "should",
      "id": "N-S018-004"
    },
    {
      "statement_id": "N-S018-5",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "ppp_fsm",
      "description": "Instead of a constant value, the Restart timer MAY begin at an initial small value and increase to the configured final value.",
      "is_inferred": false,
