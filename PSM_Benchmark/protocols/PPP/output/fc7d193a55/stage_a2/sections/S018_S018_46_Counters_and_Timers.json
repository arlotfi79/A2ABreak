      "actions": [
        "start Restart timer at a small initial value and exponentially increase toward the configured final value"
      ],
      "modality": "may",
      "id": "N-S018-005"
    },
    {
      "statement_id": "N-S018-6",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "ppp_fsm",
      "description": "Each successive value less than the final value SHOULD be at least twice the previous value.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S018",
      "actors": [
        "implementation"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "Timeout",
      "pre_cond": "restart_timer.current_value < restart_timer.final_value",
      "post_cond": "restart_timer.next_value >= restart_timer.current_value * 2",
      "actions": [
        "set next Restart timer interval to at least twice the current interval"
      ],
      "modality": "should",
      "id": "N-S018-006"
    },
    {
      "statement_id": "N-S018-7",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "ppp_fsm",
      "description": "The initial value SHOULD be large enough to account for the size of the packets, twice the round trip time for transmission at the link speed, and at least an additional 100 milliseconds to allow the peer to process the packets before responding.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S018",
      "actors": [
        "implementation",
        "peer"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": "restart_timer.initial_value >= (packet_transmission_time + 2 * round_trip_time + 100ms)",
      "actions": [
        "set initial Restart timer value to cover packet size, twice round-trip time, and at least 100ms peer processing margin"
      ],
      "modality": "should",
      "id": "N-S018-007"
    },
