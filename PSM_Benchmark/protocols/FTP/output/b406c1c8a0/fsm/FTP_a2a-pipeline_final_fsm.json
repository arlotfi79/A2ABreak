  "transitions": [
    {
      "from": "Listening",
      "event": "receive TCP connect",
      "action": "initiate control connection",
      "to": "ControlConnEstablished"
    },
    {
      "from": "ControlConnEstablished",
      "event": "cond server ready",
      "action": "send 220 awaiting input",
      "to": "AwaitingInput"
    },
    {
      "from": "ControlConnEstablished",
      "event": "cond server unready",
      "action": "send 120 expected delay",
      "to": "ExpectedDelay"
    },
    {
      "from": "ControlConnEstablished",
      "event": "receive reply 421",
      "action": "send 421 close connection",
      "to": "Closed"
    },
    {
      "from": "AwaitingInput",
      "event": "receive USER 230",
      "action": "send 230 user logged in",
      "to": "LoggedIn"
    },
    {
      "from": "AwaitingInput",
      "event": "receive USER 331",
      "action": "send 331 need password",
      "to": "NeedPassword"
    },
    {
      "from": "AwaitingInput",
      "event": "receive USER 332",
      "action": "send 332 need account",
      "to": "NeedAccount"
    },
    {
      "from": "NeedPassword",
      "event": "receive PASS 230",
      "action": "send 230 user logged in",
      "to": "LoggedIn"
    },
    {
      "from": "NeedPassword",
      "event": "receive PASS 332",
      "action": "send 332 need account",
      "to": "NeedAccount"
    },
    {
      "from": "NeedPassword",
      "event": "receive PASS 530",
      "action": "send 530 login failed",
      "to": "AwaitingInput"
    },
    {
      "from": "NeedAccount",
      "event": "receive ACCT 230",
      "action": "send 230 user logged in",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive PASV 227",
      "action": "send 227 entering passive",
      "to": "EnteringPassiveMode"
    },
    {
      "from": "LoggedIn",
      "event": "receive service command",
      "action": "send 125 or 150",
      "to": "DataTransfer"
    },
    {
      "from": "DataTransfer",
      "event": "receive ABOR",
      "action": "abort transfer close data",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive RNFR 350",
      "action": "send 350 pending info",
      "to": "RenamePending"
    },
    {
      "from": "RenamePending",
      "event": "receive RNTO 250",
      "action": "rename file send 250",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive REST 350",
      "action": "send 350 restart marker",
      "to": "RestartPending"
    },
    {
      "from": "LoggedIn",
      "event": "receive QUIT",
      "action": "close control connection",
      "to": "Closed"
    },
    {
      "from": "DataTransfer",
      "event": "receive QUIT",
      "action": "close connection after result",
      "to": "Closed"
    },
    {
      "from": "DataTransfer",
      "event": "receive reply 2yz",
      "action": "close data connection",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive ABOR idle",
      "action": "close data if open",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive TYPE",
      "action": "send 200 command OK",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive STOR denied",
      "action": "send 550 access denied",
      "to": "LoggedIn"
    },
    {
      "from": "LoggedIn",
      "event": "receive REIN 220",
      "action": "reinitialize session defaults",
      "to": "AwaitingInput"
    },
    {
      "from": "LoggedIn",
      "event": "receive REIN 120",
      "action": "send 120 then 220",
      "to": "Awaiting220"
    },
    {
      "from": "RestartPending",
      "event": "send transfer command",
      "action": "send transfer command",
      "to": "DataTransfer"
    },
    {
      "from": "LoggedIn",
      "event": "receive USER relogin",
      "action": "flush credentials restart login",
      "to": "NeedPassword"
    },
    {
      "from": "LoggedIn",
      "event": "receive MKD",
      "action": "send access denied reply",
      "to": "LoggedIn"
    },
    {
      "from": "Active",
