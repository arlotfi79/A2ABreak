      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "dccp_fsm",
      "description": "In this case, the HC-Receiver should either compress the buffer (by increasing run lengths when possible), transfer its state to a larger buffer, or, as a last resort, drop all received packets, without processing them at all, until its buffer shrinks again.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S130",
      "actors": [
        "HC-Receiver"
      ],
      "from_state": null,
      "to_state": null,
