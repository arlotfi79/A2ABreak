      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "dccp_fsm",
      "description": "If several packets are missing, the HC-Receiver may prefer to enter multiple bytes with run length 0, rather than a single byte with a larger run length; this simplifies table updates if one of the missing packets arrives.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S130",
      "actors": [
