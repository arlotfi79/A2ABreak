      "statement_id": "D-S050-001",
      "normative_level": "DEFINITION",
      "category": "FSM_STATE",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "A stateless UAS is a UAS that does not maintain transaction state. It replies to requests normally, but discards any state that would ordinarily be retained by a UAS after a response has been sent.",
      "is_inferred": false,
      "confidence": 0.95,
      "source_section": "S050",
      "state_name": "STATELESS",
      "enum_name": "UAS_OPERATING_MODE",
      "semantic_type": "active",
      "is_initial": false,
      "is_final": false,
      "invariant_cond": "server.transaction_state = null"
    },
    {
      "statement_id": "D-S050-002",
      "normative_level": "DEFINITION",
      "category": "ONEOF_CONSTRAINT",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "A UAS can operate in either a stateful or stateless mode for each new request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S050",
      "object_name": "UAS",
      "field_name": "operating_mode",
      "field_type": "state variable",
      "required": true,
      "allowed_values": [
        "stateful",
        "stateless"
      ],
      "guard_semantics": "selected independently per new request"
    },
    {
      "statement_id": "D-S050-003",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "Stateless UASs do not use a transaction layer; they receive requests directly from the transport layer and send responses directly to the transport layer.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S050",
      "actors": [
        "UAS",
        "transport_layer"
      ],
      "from_state": "STATELESS",
      "to_state": "STATELESS",
      "trigger": "receive_request_from_transport",
      "pre_cond": "server.operating_mode = STATELESS",
      "post_cond": "server.transaction_state = null",
      "actions": [
        "generate_response",
        "send_response_to_transport",
        "discard_state"
      ],
      "modality": "unspecified"
    },
    {
      "statement_id": "D-S050-004",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "If a stateless UAS receives a retransmission of a request, it regenerates the response and resends it, just as if it were replying to the first instance of the request.",
      "is_inferred": false,
      "confidence": 0.95,
      "source_section": "S050",
      "actors": [
        "UAS"
      ],
      "from_state": "STATELESS",
      "to_state": "STATELESS",
      "trigger": "receive_request_retransmission",
      "pre_cond": "server.operating_mode = STATELESS",
      "post_cond": "server.transaction_state = null",
      "actions": [
        "regenerate_response",
        "send_response_to_transport"
      ],
      "modality": "unspecified"
    },
