    {
      "statement_id": "D-S006-003",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "A SIP transaction occurs between a client and a server and comprises all messages from the first request sent from the client to the server up to a final (non-1xx) response sent from the server to the client.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S006",
      "actors": [
        "client",
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "first request sent from client to server",
      "pre_cond": null,
      "post_cond": "transaction.active = true",
      "actions": [
        "begin transaction"
      ],
      "modality": "unspecified"
    },
    {
      "statement_id": "D-S006-004",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "A final response terminates a SIP transaction, as opposed to a provisional response that does not. All 2xx, 3xx, 4xx, 5xx and 6xx responses are final.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S006",
      "actors": [
        "server",
        "client"
      ],
      "from_state": null,
      "to_state": "Terminated",
      "trigger": "final response received",
      "pre_cond": "response.code >= 200",
      "post_cond": "transaction.terminated = true",
      "actions": [
        "terminate transaction"
      ],
      "modality": "unspecified"
    },
    {
      "statement_id": "D-S006-005",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "A provisional response (1xx) does not terminate a SIP transaction.",
