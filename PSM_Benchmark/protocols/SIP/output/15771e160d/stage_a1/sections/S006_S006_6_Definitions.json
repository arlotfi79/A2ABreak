      "category": "IMPLICIT_TRANSITION",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "A dialog is established by SIP messages, such as a 2xx response to an INVITE request.",
      "is_inferred": false,
      "confidence": 0.95,
      "source_section": "S006",
      "actors": [
