      "from_state": null,
      "to_state": null,
      "trigger": "receive_420",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "retry_request_omitting_unsupported_extensions",
        "create_new_transaction"
      ],
      "modality": "should"
    },
