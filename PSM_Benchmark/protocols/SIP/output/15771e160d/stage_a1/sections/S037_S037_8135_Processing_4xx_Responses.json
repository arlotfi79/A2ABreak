      "statement_id": "D-S037-001",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a 401 (Unauthorized) or 407 (Proxy Authentication Required) response is received, the UAC SHOULD follow the authorization procedures of Section 22.2 and Section 22.3 to retry the request with credentials.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S037",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_401_or_407",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "retry_request_with_credentials",
        "create_new_transaction"
      ],
      "modality": "should"
    },
    {
      "statement_id": "D-S037-002",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a 413 (Request Entity Too Large) response is received, the UAC SHOULD retry the request, either omitting the body or using one of a smaller length.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S037",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_413",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "retry_request_with_smaller_or_no_body",
        "create_new_transaction"
      ],
      "modality": "should"
    },
    {
      "statement_id": "D-S037-003",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a 415 (Unsupported Media Type) response is received, the UAC SHOULD retry sending the request, this time only using content with types listed in the Accept header field in the response.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S037",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_415",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "retry_request_with_supported_media_types",
        "create_new_transaction"
      ],
      "modality": "should"
    },
    {
      "statement_id": "D-S037-004",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a 416 (Unsupported URI Scheme) response is received, the client SHOULD retry the request, this time, using a SIP URI.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S037",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_416",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "retry_request_with_sip_uri",
        "create_new_transaction"
      ],
      "modality": "should"
    },
    {
      "statement_id": "D-S037-005",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a 420 (Bad Extension) response is received, the UAC SHOULD retry the request, this time omitting any extensions listed in the Unsupported header field in the response.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S037",
      "actors": [
