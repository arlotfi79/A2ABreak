      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "In the case of a transaction where the request was an INVITE (known as an INVITE transaction), the transaction also includes the ACK only if the final response was not a 2xx response. If the response was a 2xx, the ACK is not considered part of the transaction.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S118",
      "object_name": "INVITE transaction",
      "field_name": "ACK",
      "field_type": "message",
      "required": false,
