      "subject": "session",
      "stage": "sip_fsm",
      "description": "A UAS core receiving a BYE request for an existing dialog MUST follow the procedures of Section 12.2.2 to process the request. Once done, the UAS SHOULD terminate the session (and therefore stop sending and listening for media). The UAS core MUST generate a 2xx response to the BYE, and MUST pass that to the server transaction for transmission.",
      "is_inferred": false,
      "confidence": 0.95,
      "source_section": "S101",
      "actors": [
        "UAS"
      ],
      "from_state": null,
      "to_state": "Terminated",
      "trigger": "BYE_received_matching_dialog",
      "pre_cond": "dialog.match = true",
      "post_cond": "session.state = Terminated",
      "actions": [
        "process BYE per Section 12.2.2",
        "terminate session",
        "stop sending media",
        "stop listening for media",
        "generate 2xx response",
        "pass 2xx response to server transaction"
      ],
      "modality": "must"
    },
    {
      "statement_id": "D-S101-003",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "The UAS MUST still respond to any pending requests received for that dialog. It is RECOMMENDED that a 487 (Request Terminated) response be generated to those pending requests.",
