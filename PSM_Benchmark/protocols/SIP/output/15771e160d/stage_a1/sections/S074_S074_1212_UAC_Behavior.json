      "normative_level": "DEFINITION",
      "category": "FIELD_PRESENCE",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "The route set MUST be set to the list of URIs in the Record-Route header field from the response, taken in reverse order and preserving all URI parameters. If no Record-Route header field is present in the response, the route set MUST be set to the empty set.",
      "is_inferred": false,
      "confidence": 0.95,
