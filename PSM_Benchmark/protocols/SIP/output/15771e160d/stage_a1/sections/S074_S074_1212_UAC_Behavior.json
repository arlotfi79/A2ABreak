      "subject": "session",
      "stage": "sip_fsm",
      "description": "When a UAC receives a response that establishes a dialog, it constructs the state of the dialog. This state MUST be maintained for the duration of the dialog.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S074",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": "dialog",
      "trigger": "receive response establishing dialog",
      "pre_cond": null,
      "post_cond": "dialog.state = constructed",
      "actions": [
        "construct dialog state",
        "set route set",
        "set local sequence number",
        "set remote sequence number to empty",
        "set call identifier",
        "set local tag",
        "set remote tag",
        "set remote target",
        "set remote URI",
        "set local URI"
      ],
      "modality": "must"
    },
    {
      "statement_id": "D-S074-002",
      "normative_level": "DEFINITION",
      "category": "FIELD_PRESENCE",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "If the request was sent over TLS, and the Request-URI contained a SIPS URI, the 'secure' flag is set to TRUE.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S074",
      "object_name": "dialog",
      "field_name": "secure",
      "field_type": "flag",
      "required": true,
      "allowed_values": [
        "TRUE"
      ],
      "guard_semantics": "request.transport = TLS & request.request_uri.scheme = SIPS"
    },
