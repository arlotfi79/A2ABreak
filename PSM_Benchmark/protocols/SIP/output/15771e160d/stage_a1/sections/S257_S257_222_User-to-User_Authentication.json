      "guard_semantics": null
    },
    {
      "statement_id": "D-S257-003",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When the originating UAC receives the 401 (Unauthorized), it SHOULD, if it is able, re-originate the request with the proper credentials.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S257",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "401_unauthorized_received",
      "pre_cond": "response.status_code = 401",
      "post_cond": "request.Authorization != null",
      "actions": [
        "re-originate request with credentials"
      ],
      "modality": "should"
    },
    {
      "statement_id": "D-S257-004",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When a UAC resubmits a request with its credentials after receiving a 401 (Unauthorized) or 407 (Proxy Authentication Required) response, it MUST increment the CSeq header field value as it would normally when sending an updated request.",
      "is_inferred": false,
      "confidence": 0.95,
      "source_section": "S257",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "resubmit_request_after_auth_challenge",
      "pre_cond": "response.status_code = 401 | response.status_code = 407",
      "post_cond": "request.CSeq = prior_request.CSeq + 1",
      "actions": [
        "increment CSeq header field value",
        "include Authorization header with credentials"
      ],
      "modality": "must"
    },
    {
      "statement_id": "D-S257-005",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If no credentials for a realm can be located, UACs MAY attempt to retry the request with a username of 'anonymous' and no password.",
      "is_inferred": false,
      "confidence": 0.75,
      "source_section": "S257",
      "actors": [
