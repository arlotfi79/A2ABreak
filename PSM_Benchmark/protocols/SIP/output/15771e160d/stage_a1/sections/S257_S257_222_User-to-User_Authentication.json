      "subject": "server",
      "stage": "sip_fsm",
      "description": "If no credentials (in the Authorization header field) are provided in the request, the UAS can challenge the originator to provide credentials by rejecting the request with a 401 (Unauthorized) status code.",
      "is_inferred": false,
      "confidence": 0.85,
      "source_section": "S257",
      "actors": [
        "UAS",
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "request_received_without_credentials",
      "pre_cond": "request.Authorization = null",
      "post_cond": "response.status_code = 401",
      "actions": [
        "send 401 Unauthorized",
        "include WWW-Authenticate header with challenge"
      ],
      "modality": "may"
    },
    {
      "statement_id": "D-S257-002",
      "normative_level": "DEFINITION",
      "category": "FIELD_PRESENCE",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "The WWW-Authenticate response-header field MUST be included in 401 (Unauthorized) response messages.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S257",
      "object_name": "401 Unauthorized response",
      "field_name": "WWW-Authenticate",
      "field_type": "header field",
      "required": true,
