      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "The UAC core considers the INVITE transaction completed 64*T1 seconds after the reception of the first 2xx response.",
