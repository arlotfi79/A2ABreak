      "category": "IMPLICIT_TRANSITION",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "If the dialog identifier in the 2xx response matches the dialog identifier of an existing dialog, the dialog MUST be transitioned to the \"confirmed\" state, and the route set for the dialog MUST be recomputed based on the 2xx response.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S088",
      "actors": [
        "UAC"
      ],
      "from_state": "early",
      "to_state": "confirmed",
      "trigger": "2xx_response_received",
      "pre_cond": "dialog.id = response.dialog_id",
      "post_cond": "dialog.state = confirmed & dialog.route_set = recomputed",
      "actions": [
        "recompute_route_set",
        "generate_ACK"
      ],
      "modality": "must"
    },
    {
      "statement_id": "D-S088-004",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "Otherwise, a new dialog in the \"confirmed\" state MUST be constructed using the procedures of Section 12.1.2.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S088",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": "confirmed",
      "trigger": "2xx_response_received",
      "pre_cond": "dialog.id != response.dialog_id",
      "post_cond": "new_dialog.state = confirmed",
      "actions": [
        "construct_new_dialog",
        "generate_ACK"
      ],
      "modality": "must"
    },
    {
