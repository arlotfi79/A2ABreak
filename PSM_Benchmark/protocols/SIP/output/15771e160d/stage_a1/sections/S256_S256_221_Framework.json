      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "any credentials in the INVITE that were accepted by a server MUST be accepted by that server for the ACK.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S256",
      "actors": [
        "server",
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "server receives ACK",
      "pre_cond": "server.accepted_credentials_for_invite = true",
