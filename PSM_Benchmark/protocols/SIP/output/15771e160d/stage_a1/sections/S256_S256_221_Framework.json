      "modality": "unspecified"
    },
    {
      "statement_id": "D-S256-002",
      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "registrars and redirect servers MAY make use of 401 (Unauthorized) responses for authentication, but proxies MUST NOT, and instead MAY use the 407 (Proxy Authentication Required) response.",
      "is_inferred": false,
      "confidence": 0.9,
      "source_section": "S256",
      "actors": [
        "proxy",
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "proxy receives unauthenticated request",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "send 407 Proxy Authentication Required"
      ],
      "modality": "may"
    },
    {
