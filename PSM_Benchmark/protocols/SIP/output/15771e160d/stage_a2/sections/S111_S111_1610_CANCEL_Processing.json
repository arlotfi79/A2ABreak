      "trigger": "matching_response_context_found",
      "pre_cond": "response_context.match = true & client_transactions.pending.count > 0",
      "post_cond": "CANCEL.generated_for_all_pending_client_transactions = true",
      "actions": [
        "generate CANCEL requests for all pending client transactions in the context per Section 16.7 step 10"
