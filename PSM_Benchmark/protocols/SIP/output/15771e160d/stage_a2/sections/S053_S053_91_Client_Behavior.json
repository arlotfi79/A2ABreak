      "statement_id": "N-S053-7",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "Once the CANCEL is constructed, the client SHOULD check whether it has received any response (provisional or final) for the request being cancelled (herein referred to as the \"original request\").",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "CANCEL_constructed",
      "pre_cond": null,
      "post_cond": null,
      "actions": [
        "check_response_status_for_original_request"
      ],
      "modality": "should",
      "id": "N-S053-007"
    },
    {
      "statement_id": "N-S053-8",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "If no provisional response has been received, the CANCEL request MUST NOT be sent; rather, the client MUST wait for the arrival of a provisional response before sending the request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "send_CANCEL",
      "pre_cond": "provisional_response.received = false",
      "post_cond": null,
      "actions": [
        "suppress_CANCEL_transmission"
      ],
      "modality": "must",
      "id": "N-S053-008"
    },
    {
      "statement_id": "N-S053-9",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "If no provisional response has been received, the CANCEL request MUST NOT be sent; rather, the client MUST wait for the arrival of a provisional response before sending the request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
