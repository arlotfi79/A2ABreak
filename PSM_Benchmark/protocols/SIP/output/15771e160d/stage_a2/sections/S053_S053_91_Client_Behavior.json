      "normative_level": "SHOULD NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "If the original request has generated a final response, the CANCEL SHOULD NOT be sent, as it is an effective no-op, since CANCEL has no effect on requests that have already generated a final response.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "send_CANCEL",
      "pre_cond": "original_request.final_response.received = true",
      "post_cond": null,
      "actions": [
