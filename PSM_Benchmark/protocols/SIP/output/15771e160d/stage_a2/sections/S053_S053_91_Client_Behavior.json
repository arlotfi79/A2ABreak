      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "The CANCEL request MUST NOT contain any Require or Proxy-Require header fields.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
