      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "However, the method part of the CSeq header field MUST have a value of CANCEL.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S053-004"
    },
    {
      "statement_id": "N-S053-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "If the request being cancelled contains a Route header field, the CANCEL request MUST include that Route header field's values.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
