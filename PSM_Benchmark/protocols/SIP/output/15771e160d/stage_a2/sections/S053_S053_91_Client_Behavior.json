    },
    {
      "statement_id": "N-S053-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "The Request-URI, Call-ID, To, the numeric part of CSeq, and From header fields in the CANCEL request MUST be identical to those in the request being cancelled, including tags.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S053-002"
    },
    {
      "statement_id": "N-S053-3",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "A CANCEL constructed by a client MUST have only a single Via header field value matching the top Via value in the request being cancelled.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S053",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S053-003"
    },
