      "stage": "sip_fsm",
      "description": "If the From header field in an encrypted body differs from the value in the \"outer\" message, the value within the encrypted body SHOULD be displayed to the user, but MUST NOT be used in the \"outer\" header fields of any future messages.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S267",
      "actors": [
        "UA",
        "user"
      ],
      "from_state": null,
