      "trigger": "encrypted_body_From_differs_from_outer_From",
      "pre_cond": "message.encrypted_body.From != message.outer.From",
      "post_cond": null,
      "actions": [
        "display encrypted body From value to user"
      ],
      "modality": "should",
      "id": "N-S267-001"
    },
