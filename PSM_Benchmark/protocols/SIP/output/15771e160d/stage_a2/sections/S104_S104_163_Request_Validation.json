      "actions": [
        "check_for_forwarding_loops"
      ],
      "modality": "may",
      "id": "N-S104-012"
    },
    {
      "statement_id": "N-S104-13",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "To determine if the request has looped, the element MAY perform the branch parameter calculation described in Step 8 of Section 16.6 on this message and compare it to the parameter received in that Via header field.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S104",
      "actors": [
        "element"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "Via_sent-by_matches_proxy_value",
      "pre_cond": "request.Via.sent-by = proxy.previously_inserted_sent-by",
      "post_cond": null,
      "actions": [
        "calculate_branch_parameter_per_section_16.6_step_8",
        "compare_branch_to_received_Via_parameter"
      ],
      "modality": "may",
      "id": "N-S104-013"
    },
