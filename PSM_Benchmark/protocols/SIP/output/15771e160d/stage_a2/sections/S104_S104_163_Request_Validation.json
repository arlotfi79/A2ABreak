      "source_section": "S104",
      "actors": [
        "element"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "Max-Forwards_zero_check",
      "pre_cond": "request.Max-Forwards = 0 & request.method = OPTIONS",
      "post_cond": null,
      "actions": [
        "act_as_final_recipient",
        "respond_per_section_11"
