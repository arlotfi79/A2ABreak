      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "sip_fsm",
      "description": "To address these concerns, it is RECOMMENDED that recipients of a request whose Request-URI contains a SIP or SIPS URI inspect the To header field value to see if it contains a SIPS URI (though note that it does not constitute a breach of security if this URI has the same scheme but is not equivalent to the URI in the To header field).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S297",
      "actors": [
        "recipients"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_request_with_SIP_or_SIPS_Request_URI",
      "pre_cond": "request.Request_URI.scheme = SIP | request.Request_URI.scheme = SIPS",
      "post_cond": null,
      "actions": [
        "inspect_To_header_field_value_for_SIPS_URI"
      ],
      "modality": "should",
      "id": "N-S297-001"
    },
    {
      "statement_id": "2-S297-2",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "sip_fsm",
      "description": "Recipients MAY also inspect the Via header chain in order to double-check whether or not TLS was used for the entire request path until the local administrative domain was reached.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S297",
      "actors": [
