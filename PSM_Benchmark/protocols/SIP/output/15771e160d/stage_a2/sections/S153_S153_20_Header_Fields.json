      "confidence": 1.0,
      "source_section": "S153",
      "actors": [
        "client",
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "transport.type = stream_based",
      "post_cond": "header_field.sent = true",
      "actions": [
        "send_header_field"
      ],
      "modality": "must",
      "id": "N-S153-003"
    },
    {
      "statement_id": "N-S153-4",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "sip_fsm",
      "description": "\"Optional\" means that an element MAY include the header field in a request or response, and a UA MAY ignore the header field if present in the request or response (The exception to this rule is the Require header field discussed in 20.32).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S153",
      "actors": [
        "UA"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "header_field.presence = optional",
      "post_cond": null,
      "actions": [],
      "modality": "may",
      "id": "N-S153-004"
    },
    {
      "statement_id": "N-S153-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "A \"mandatory\" header field MUST be present in a request, and MUST be understood by the UAS receiving the request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S153",
      "actors": [
        "UAS"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_request",
      "pre_cond": "header_field.mandatory = true & message.type = request",
      "post_cond": "header_field.present_in_request = true & UAS.understands_header = true",
      "actions": [
        "include_mandatory_header_in_request",
        "UAS_process_mandatory_header"
      ],
      "modality": "must",
      "id": "N-S153-005"
    },
    {
      "statement_id": "N-S153-6",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "A mandatory response header field MUST be present in the response, and the header field MUST be understood by the UAC processing the response.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S153",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_response",
      "pre_cond": "header_field.mandatory = true & message.type = response",
      "post_cond": "header_field.present_in_response = true & UAC.understands_header = true",
      "actions": [
        "include_mandatory_header_in_response",
        "UAC_process_mandatory_response_header"
      ],
      "modality": "must",
      "id": "N-S153-006"
    },
    {
      "statement_id": "N-S153-7",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "\"Not applicable\" means that the header field MUST NOT be present in a request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S153",
      "actors": [],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "header_field.applicable = false & message.type = request",
      "post_cond": "header_field.present_in_request = false",
      "actions": [],
      "modality": "must",
      "id": "N-S153-007"
    },
    {
      "statement_id": "N-S153-8",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "If one is placed in a request by mistake, it MUST be ignored by the UAS receiving the request.",
