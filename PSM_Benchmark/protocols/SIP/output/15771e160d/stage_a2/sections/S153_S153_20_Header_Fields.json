      "from_state": null,
      "to_state": null,
      "trigger": "receive_request_with_not_applicable_header",
      "pre_cond": "header_field.applicable = false & header_field.present_in_request = true",
      "post_cond": null,
      "actions": [
        "ignore_not_applicable_header_in_request"
      ],
      "modality": "must",
      "id": "N-S153-008"
    },
    {
      "statement_id": "N-S153-9",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "participant",
      "stage": "sip_fsm",
      "description": "Similarly, a header field labeled \"not applicable\" for a response means that the UAS MUST NOT place the header field in the response, and the UAC MUST ignore the header field in the response.",
