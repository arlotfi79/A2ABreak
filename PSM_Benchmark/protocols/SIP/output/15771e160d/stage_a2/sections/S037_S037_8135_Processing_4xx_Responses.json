      "to_state": null,
      "trigger": "recv_415",
      "pre_cond": "response.status = 415",
      "post_cond": null,
      "actions": [
        "retry_request_using_Accept_listed_content_types",
        "retry_request_using_Accept-Encoding_listed_encodings",
        "retry_request_using_Accept-Language_listed_languages"
      ],
      "modality": "should",
      "id": "N-S037-003"
