      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "The UAC SHOULD retry sending the request, this time only using content with types listed in the Accept header field in the response, with encodings listed in the Accept-Encoding header field in the response, and with languages listed in the Accept-Language in the response.",
      "is_inferred": false,
