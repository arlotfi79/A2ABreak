      "post_cond": "response.code = 481 & response.passed_to_server_transaction = true",
      "actions": [
        "generate 481 (Call/Transaction Does Not Exist) response",
        "pass response to server transaction"
      ],
      "modality": "should",
      "id": "N-S101-001"
    },
    {
      "statement_id": "N-S101-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "A UAS core receiving a BYE request for an existing dialog MUST follow the procedures of Section 12.2.2 to process the request.",
