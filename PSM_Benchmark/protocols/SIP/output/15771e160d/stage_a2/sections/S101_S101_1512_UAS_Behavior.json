      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "Whether or not it ends its participation on the session, the UAS core MUST generate a 2xx response to the BYE, and MUST pass that to the server transaction for transmission.",
