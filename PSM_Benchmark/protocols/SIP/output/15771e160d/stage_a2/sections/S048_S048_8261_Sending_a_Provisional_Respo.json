      ],
      "from_state": null,
      "to_state": null,
      "trigger": "100 (Trying) response generation",
      "pre_cond": "response.status_code = 100 & request.header.Timestamp != null",
      "post_cond": "response.header.Timestamp = request.header.Timestamp",
      "actions": [
        "copy Timestamp header field from request into 100 (Trying) response"
      ],
      "modality": "must",
      "id": "N-S048-003"
    },
