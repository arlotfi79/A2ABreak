    {
      "statement_id": "N-S256-13",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "sip_fsm",
      "description": "Generally, a CANCEL request SHOULD be accepted by a server if it comes from the same hop that sent the request being canceled (provided that some sort of transport or network layer security association, as described in Section 26.2.1, is in place).",
