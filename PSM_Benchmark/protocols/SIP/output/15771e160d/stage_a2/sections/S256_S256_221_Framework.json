      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "A UAC MUST NOT re-attempt requests with the credentials that have just been rejected (though the request may be retried if the nonce was stale).",
