      "confidence": 1.0,
      "source_section": "S256",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_CANCEL",
      "pre_cond": "CANCEL.source_hop = original_request.source_hop & security_association.in_place = true",
      "post_cond": null,
      "actions": [
        "accept_CANCEL_request"
      ],
      "modality": "should",
      "id": "N-S256-013"
    },
    {
      "statement_id": "N-S256-14",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "When a UAC receives a challenge, it SHOULD render to the user the contents of the \"realm\" parameter in the challenge (which appears in either a WWW-Authenticate header field or Proxy-Authenticate header field) if the UAC device does not already know of a credential for the realm in question.",
