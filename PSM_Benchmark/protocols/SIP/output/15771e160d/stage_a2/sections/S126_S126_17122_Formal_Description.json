      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If a final response (status codes 200-699) is received while in the \"Proceeding\" state, the response MUST be passed to the TU, and the client transaction MUST transition to the \"Completed\" state.",
