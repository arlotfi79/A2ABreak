      "source_section": "S122",
      "actors": [
        "client transaction",
        "TU"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer B fires",
      "pre_cond": "transaction.state = Calling",
      "post_cond": "TU.notified_of_timeout = true",
      "actions": [
        "Inform TU that a timeout has occurred"
      ],
      "modality": "should",
      "id": "N-S122-013"
    },
    {
