      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Enter Calling state",
      "pre_cond": "transport.type = unreliable",
      "post_cond": "timer_A.started = true & timer_A.value = T1",
      "actions": [
        "Start timer A with value T1"
      ],
      "modality": "must",
      "id": "N-S122-003"
    },
    {
      "statement_id": "N-S122-4",
      "normative_level": "SHOULD NOT",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "sip_fsm",
      "description": "If a reliable transport is being used, the client transaction SHOULD NOT start timer A (Timer A controls request retransmissions).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Enter Calling state",
      "pre_cond": "transport.type = reliable",
      "post_cond": "timer_A.started = false",
      "actions": [],
      "modality": "should",
      "id": "N-S122-004"
    },
    {
      "statement_id": "N-S122-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "sip_fsm",
      "description": "For any transport, the client transaction MUST start timer B with a value of 64*T1 seconds (Timer B controls transaction timeouts).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Enter Calling state",
      "pre_cond": null,
      "post_cond": "timer_B.started = true & timer_B.value = 64*T1",
      "actions": [
        "Start timer B with value 64*T1"
      ],
      "modality": "must",
      "id": "N-S122-005"
    },
    {
      "statement_id": "N-S122-6",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When timer A fires, the client transaction MUST retransmit the request by passing it to the transport layer, and MUST reset the timer with a value of 2*T1.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "transport layer"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer A fires",
      "pre_cond": "transaction.state = Calling",
      "post_cond": "request.retransmitted = true & timer_A.value = 2*T1",
      "actions": [
        "Retransmit INVITE request by passing to transport layer",
        "Reset timer A with value 2*T1"
      ],
      "modality": "must",
      "id": "N-S122-006"
    },
    {
      "statement_id": "N-S122-7",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When timer A fires 2*T1 seconds later, the request MUST be retransmitted again (assuming the client transaction is still in this state).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer A fires",
      "pre_cond": "transaction.state = Calling",
      "post_cond": "request.retransmitted = true",
      "actions": [
        "Retransmit INVITE request"
      ],
      "modality": "must",
      "id": "N-S122-007"
    },
    {
      "statement_id": "N-S122-8",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "This process MUST continue so that the request is retransmitted with intervals that double after each transmission.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer A fires repeatedly",
      "pre_cond": "transaction.state = Calling",
      "post_cond": "retransmit_interval = previous_interval * 2",
      "actions": [
        "Double retransmission interval after each timer A expiry and retransmit request"
      ],
      "modality": "must",
      "id": "N-S122-008"
    },
    {
      "statement_id": "N-S122-9",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "These retransmissions SHOULD only be done while the client transaction is in the \"calling\" state.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer A fires",
      "pre_cond": "transaction.state = Calling",
      "post_cond": null,
      "actions": [],
      "modality": "should",
      "id": "N-S122-009"
    },
    {
