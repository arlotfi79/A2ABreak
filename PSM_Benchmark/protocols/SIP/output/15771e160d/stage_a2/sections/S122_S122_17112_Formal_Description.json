      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "sip",
      "stage": "sip_fsm",
      "description": "Elements MAY (though it is NOT RECOMMENDED) use smaller values of T1 within closed, private networks that do not permit general Internet connection.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "SIP elements"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
