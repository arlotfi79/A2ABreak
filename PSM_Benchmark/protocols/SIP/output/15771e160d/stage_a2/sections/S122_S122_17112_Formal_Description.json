      "pre_cond": "transaction.state = Calling & timer_B.fired = true",
      "post_cond": "ACK.generated = false",
      "actions": [],
      "modality": "must",
      "id": "N-S122-014"
    },
    {
      "statement_id": "N-S122-15",
      "normative_level": "SHOULD NOT",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "In the \"Proceeding\" state, the client transaction SHOULD NOT retransmit the request any longer.",
