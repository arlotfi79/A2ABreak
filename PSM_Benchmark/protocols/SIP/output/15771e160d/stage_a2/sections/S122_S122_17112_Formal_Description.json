      "normative_level": "RECOMMENDED",
      "category": "BEHAVIORAL",
      "subject": "sip",
      "stage": "sip_fsm",
      "description": "T1 MAY be chosen larger, and this is RECOMMENDED if it is known in advance (such as on high latency access links) that the RTT is larger.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "SIP elements"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
