      "trigger": "Provisional response received in Calling state",
      "pre_cond": "transaction.state = Calling & response.status_code >= 100 & response.status_code <= 199",
      "post_cond": "provisional_response.passed_to_TU = true & transaction.state = Proceeding",
      "actions": [
        "Pass provisional response to TU"
      ],
      "modality": "must",
      "id": "N-S122-016"
    },
    {
      "statement_id": "N-S122-17",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "Any further provisional responses MUST be passed up to the TU while in the \"Proceeding\" state.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "TU"
      ],
      "from_state": "Proceeding",
      "to_state": null,
      "trigger": "Provisional response received",
      "pre_cond": "transaction.state = Proceeding & response.status_code >= 100 & response.status_code <= 199",
      "post_cond": "provisional_response.passed_to_TU = true",
      "actions": [
        "Pass provisional response to TU"
      ],
      "modality": "must",
      "id": "N-S122-017"
    },
    {
      "statement_id": "N-S122-18",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When in either the \"Calling\" or \"Proceeding\" states, reception of a response with status code from 300-699 MUST cause the client transaction to transition to \"Completed\".",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling | Proceeding",
      "to_state": "Completed",
      "trigger": "Response received with status code 300-699",
      "pre_cond": "(transaction.state = Calling | transaction.state = Proceeding) & response.status_code >= 300 & response.status_code <= 699",
      "post_cond": "transaction.state = Completed",
      "actions": [
        "Transition to Completed state"
      ],
      "modality": "must",
      "id": "N-S122-018"
    },
    {
      "statement_id": "N-S122-19",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "The client transaction MUST pass the received response up to the TU, and the client transaction MUST generate an ACK request, even if the transport is reliable (guidelines for constructing the ACK from the response are given in Section 17.1.1.3) and then pass the ACK to the transport layer for transmission.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "TU",
        "transport layer"
      ],
      "from_state": "Calling | Proceeding",
      "to_state": "Completed",
      "trigger": "Response received with status code 300-699",
      "pre_cond": "(transaction.state = Calling | transaction.state = Proceeding) & response.status_code >= 300 & response.status_code <= 699",
      "post_cond": "response.passed_to_TU = true & ACK.generated = true & ACK.passed_to_transport = true",
      "actions": [
        "Pass received response to TU",
        "Generate ACK request",
        "Pass ACK to transport layer for transmission"
      ],
      "modality": "must",
      "id": "N-S122-019"
    },
    {
      "statement_id": "N-S122-20",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "sip_fsm",
      "description": "The ACK MUST be sent to the same address, port, and transport to which the original request was sent.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Completed",
      "to_state": null,
      "trigger": "ACK generation on 300-699 response",
      "pre_cond": "ACK.generated = true",
      "post_cond": "ACK.destination_address = original_request.destination_address & ACK.destination_port = original_request.destination_port & ACK.transport = original_request.transport",
      "actions": [
        "Send ACK to same address, port, and transport as original INVITE request"
      ],
      "modality": "must",
      "id": "N-S122-020"
    },
    {
      "statement_id": "N-S122-21",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "sip_fsm",
      "description": "The client transaction SHOULD start timer D when it enters the \"Completed\" state, with a value of at least 32 seconds for unreliable transports, and a value of zero seconds for reliable transports.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": null,
      "to_state": "Completed",
      "trigger": "Enter Completed state",
      "pre_cond": null,
      "post_cond": "timer_D.started = true & (transport.type = unreliable => timer_D.value >= 32) & (transport.type = reliable => timer_D.value = 0)",
      "actions": [
        "Start timer D with value >= 32s for unreliable transport or 0s for reliable transport"
      ],
      "modality": "should",
      "id": "N-S122-021"
    },
    {
      "statement_id": "N-S122-22",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "Any retransmissions of the final response that are received while in the \"Completed\" state MUST cause the ACK to be re-passed to the transport layer for retransmission, but the newly received response MUST NOT be passed up to the TU.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "transport layer",
        "TU"
      ],
      "from_state": "Completed",
      "to_state": null,
      "trigger": "Retransmission of final response received",
      "pre_cond": "transaction.state = Completed & response.is_retransmission = true",
      "post_cond": "ACK.re_passed_to_transport = true & response.passed_to_TU = false",
      "actions": [
        "Re-pass ACK to transport layer for retransmission",
        "Do not pass retransmitted response to TU"
      ],
      "modality": "must",
      "id": "N-S122-022"
    },
    {
      "statement_id": "N-S122-23",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If timer D fires while the client transaction is in the \"Completed\" state, the client transaction MUST move to the terminated state.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Completed",
      "to_state": "Terminated",
      "trigger": "Timer D fires",
      "pre_cond": "transaction.state = Completed",
      "post_cond": "transaction.state = Terminated",
      "actions": [
        "Transition to Terminated state"
      ],
      "modality": "must",
      "id": "N-S122-023"
    },
    {
      "statement_id": "N-S122-24",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "When in either the \"Calling\" or \"Proceeding\" states, reception of a 2xx response MUST cause the client transaction to enter the \"Terminated\" state, and the response MUST be passed up to the TU.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "TU"
      ],
      "from_state": "Calling | Proceeding",
      "to_state": "Terminated",
      "trigger": "2xx response received",
      "pre_cond": "(transaction.state = Calling | transaction.state = Proceeding) & response.status_code >= 200 & response.status_code <= 299",
      "post_cond": "transaction.state = Terminated & response.passed_to_TU = true",
      "actions": [
        "Transition to Terminated state",
        "Pass 2xx response to TU"
      ],
      "modality": "must",
      "id": "N-S122-024"
    },
