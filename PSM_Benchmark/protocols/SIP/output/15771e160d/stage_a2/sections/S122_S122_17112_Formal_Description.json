      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "TU",
        "client transaction"
      ],
      "from_state": null,
      "to_state": "Calling",
      "trigger": "TU initiates new INVITE client transaction",
      "pre_cond": null,
      "post_cond": "transaction.state = Calling",
      "actions": [
        "Enter Calling state"
      ],
      "modality": "must",
      "id": "N-S122-001"
    },
    {
      "statement_id": "N-S122-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "The client transaction MUST pass the request to the transport layer for transmission (see Section 18).",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "transport layer"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "INVITE client transaction created",
      "pre_cond": "transaction.state = Calling",
      "post_cond": "request.passed_to_transport = true",
      "actions": [
        "Pass INVITE request to transport layer for transmission"
      ],
      "modality": "must",
      "id": "N-S122-002"
    },
    {
      "statement_id": "N-S122-3",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "sip_fsm",
      "description": "If an unreliable transport is being used, the client transaction MUST start timer A with a value of T1.",
