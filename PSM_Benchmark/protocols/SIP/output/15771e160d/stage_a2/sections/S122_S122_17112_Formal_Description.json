      "id": "N-S122-011"
    },
    {
      "statement_id": "N-S122-12",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "Whatever the value of T1, the exponential backoffs on retransmissions described in this section MUST be used.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Calling",
      "to_state": null,
      "trigger": "Timer A fires",
      "pre_cond": "transaction.state = Calling",
      "post_cond": null,
      "actions": [
        "Apply exponential backoff to retransmission intervals"
      ],
      "modality": "must",
      "id": "N-S122-012"
    },
    {
      "statement_id": "N-S122-13",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "If the client transaction is still in the \"Calling\" state when timer B fires, the client transaction SHOULD inform the TU that a timeout has occurred.",
