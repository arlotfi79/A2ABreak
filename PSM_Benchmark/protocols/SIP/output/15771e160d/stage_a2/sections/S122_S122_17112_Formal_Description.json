      "post_cond": "retransmission.active = false",
      "actions": [
        "Stop request retransmissions"
      ],
      "modality": "should",
      "id": "N-S122-015"
    },
    {
      "statement_id": "N-S122-16",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "Furthermore, the provisional response MUST be passed to the TU.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction",
        "TU"
      ],
      "from_state": "Calling",
