    {
      "statement_id": "N-S122-1",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "The initial state, \"calling\", MUST be entered when the TU initiates a new client transaction with an INVITE request.",
