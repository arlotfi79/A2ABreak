      "statement_id": "N-S122-25",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "transaction",
      "stage": "sip_fsm",
      "description": "The client transaction MUST be destroyed the instant it enters the \"Terminated\" state.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S122",
      "actors": [
        "client transaction"
      ],
      "from_state": "Terminated",
      "to_state": null,
      "trigger": "Enter Terminated state",
      "pre_cond": "transaction.state = Terminated",
      "post_cond": "transaction.destroyed = true",
      "actions": [
        "Destroy client transaction immediately"
      ],
      "modality": "must",
      "id": "N-S122-025"
    }
