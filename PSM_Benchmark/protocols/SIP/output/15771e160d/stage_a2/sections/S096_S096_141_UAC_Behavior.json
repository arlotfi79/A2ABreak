      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "A UAC MAY choose not to add an Alert-Info header field or a body with Content-Disposition \"alert\" to re-INVITEs because UASs do not typically alert the user upon reception of a re-INVITE.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "may",
      "id": "N-S096-003"
    },
    {
      "statement_id": "N-S096-4",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "Note that a UAC MUST NOT initiate a new INVITE transaction within a dialog while another INVITE transaction is in progress in either direction.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "initiate_new_INVITE_transaction",
      "pre_cond": "invite_transaction.state = in_progress",
      "post_cond": null,
      "actions": [],
      "modality": "must",
      "id": "N-S096-004"
    },
    {
      "statement_id": "N-S096-5",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "If there is an ongoing INVITE client transaction, the TU MUST wait until the transaction reaches the completed or terminated state before initiating the new INVITE.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "TU"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "initiate_new_INVITE",
      "pre_cond": "invite_client_transaction.state = completed | invite_client_transaction.state = terminated",
      "post_cond": null,
      "actions": [
        "wait until INVITE client transaction reaches completed or terminated state"
      ],
      "modality": "must",
      "id": "N-S096-005"
    },
    {
      "statement_id": "N-S096-6",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "sip_fsm",
      "description": "If there is an ongoing INVITE server transaction, the TU MUST wait until the transaction reaches the confirmed or terminated state before initiating the new INVITE.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "TU"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "initiate_new_INVITE",
      "pre_cond": "invite_server_transaction.state = confirmed | invite_server_transaction.state = terminated",
      "post_cond": null,
      "actions": [
        "wait until INVITE server transaction reaches confirmed or terminated state"
