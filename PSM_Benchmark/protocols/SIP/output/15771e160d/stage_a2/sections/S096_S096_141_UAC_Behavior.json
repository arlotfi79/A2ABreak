      "trigger": "send_re_INVITE",
      "pre_cond": null,
      "post_cond": "re_INVITE.session_description = null",
      "actions": [
        "send re-INVITE without session description"
      ],
      "modality": "may",
      "id": "N-S096-001"
    },
