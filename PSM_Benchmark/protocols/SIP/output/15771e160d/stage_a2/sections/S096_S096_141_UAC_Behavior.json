      "statement_id": "N-S096-9",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "session",
      "stage": "sip_fsm",
      "description": "If a UA receives a non-2xx final response to a re-INVITE, the session parameters MUST remain unchanged, as if no re-INVITE had been issued.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "UA"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_non_2xx_final_response_to_re_INVITE",
      "pre_cond": "response.final = true & response.code != 2xx & transaction.type = re_INVITE",
      "post_cond": "session.parameters = pre_re_INVITE.parameters",
      "actions": [
        "maintain session parameters unchanged from their state prior to re-INVITE"
      ],
      "modality": "must",
      "id": "N-S096-009"
    },
    {
      "statement_id": "N-S096-10",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "sip_fsm",
      "description": "If a UAC receives a 491 response to a re-INVITE, it SHOULD start a timer with a value T chosen as follows:",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S096",
      "actors": [
        "UAC"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_491_response_to_re_INVITE",
      "pre_cond": "response.code = 491 & transaction.type = re_INVITE",
      "post_cond": "timer_T.running = true",
      "actions": [
        "start timer T with value randomly chosen between 2.1 and 4 seconds in units of 10ms if UAC owns Call-ID",
        "start timer T with value randomly chosen between 0 and 2 seconds in units of 10ms if UAC does not own Call-ID"
      ],
      "modality": "should",
      "id": "N-S096-010"
    },
