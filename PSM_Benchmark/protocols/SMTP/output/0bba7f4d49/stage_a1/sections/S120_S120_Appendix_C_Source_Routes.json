      "subject": "server",
      "stage": "smtp_fsm",
      "description": "A server that is reached by means of a source route (e.g., its domain name appears first in the list in the forward-path) MUST remove its domain name from any forward-paths in which that domain name appears before forwarding the message and MAY remove all other source routing information.",
      "is_inferred": false,
      "confidence": 0.7,
      "source_section": "S120",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "server_reached_via_source_route",
      "pre_cond": "message.forward_path.first_host = server.domain_name",
      "post_cond": "message.forward_path does not contain server.domain_name",
      "actions": [
        "remove_own_domain_from_forward_path",
        "optionally_remove_all_source_routing"
      ],
      "modality": "must"
    },
