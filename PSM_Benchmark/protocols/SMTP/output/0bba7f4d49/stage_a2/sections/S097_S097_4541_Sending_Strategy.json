      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "smtp",
      "stage": "smtp_fsm",
      "description": "The parameters to the retry algorithm MUST be configurable.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
