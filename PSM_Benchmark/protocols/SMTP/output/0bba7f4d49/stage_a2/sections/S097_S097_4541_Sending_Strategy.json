      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "A client SHOULD keep a list of hosts it cannot reach and corresponding connection timeouts, rather than just retrying queued mail items.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "connection_attempt_failed",
      "pre_cond": "connection.result = failed",
      "post_cond": null,
      "actions": [
        "record_unreachable_host",
        "record_connection_timeout"
      ],
      "modality": "should",
      "id": "N-S097-006"
    },
