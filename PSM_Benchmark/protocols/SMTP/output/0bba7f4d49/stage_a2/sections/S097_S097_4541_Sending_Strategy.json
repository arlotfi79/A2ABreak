      "modality": "must",
      "id": "N-S097-002"
    },
    {
      "statement_id": "N-S097-3",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "timer",
      "stage": "smtp_fsm",
      "description": "In general, the retry interval SHOULD be at least 30 minutes; however, more sophisticated and variable strategies will be beneficial when the SMTP client can determine the reason for non-delivery.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": "retry_interval >= 30_minutes",
      "actions": [],
      "modality": "should",
      "id": "N-S097-003"
    },
    {
      "statement_id": "N-S097-4",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "It MAY be appropriate to set a shorter maximum number of retries for non-delivery notifications and equivalent error messages than for standard messages.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client",
        "sender"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "may",
      "id": "N-S097-004"
    },
    {
