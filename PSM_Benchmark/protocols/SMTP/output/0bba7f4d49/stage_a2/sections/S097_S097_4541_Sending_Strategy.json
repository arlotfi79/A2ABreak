    {
      "statement_id": "N-S097-1",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "mail that cannot be transmitted immediately MUST be queued and periodically retried by the sender.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client",
        "sender"
      ],
      "from_state": null,
      "to_state": "queued",
      "trigger": "immediate_transmission_failed",
      "pre_cond": "message.immediate_transmission = false",
      "post_cond": "message.state = queued",
      "actions": [
        "queue_message",
        "schedule_periodic_retry"
      ],
      "modality": "must",
      "id": "N-S097-001"
    },
    {
      "statement_id": "N-S097-2",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "The sender MUST delay retrying a particular destination after one attempt has failed.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "sender"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "delivery_attempt_failed",
      "pre_cond": "delivery_attempt.result = failed",
      "post_cond": null,
      "actions": [
