      "id": "N-S097-007"
    },
    {
      "statement_id": "N-S097-8",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "More significantly, 5yz responses to the MAIL command MUST NOT be cached.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receive_5yz_response_to_MAIL",
      "pre_cond": "command = MAIL & response.code >= 500 & response.code <= 599",
      "post_cond": "response.cached = false",
      "actions": [
        "do_not_cache_5yz_MAIL_response"
      ],
      "modality": "must",
      "id": "N-S097-008"
    },
    {
      "statement_id": "N-S097-9",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "When a mail message is to be delivered to multiple recipients, and the SMTP server to which a copy of the message is to be sent is the same for multiple recipients, then only one copy of the message SHOULD be transmitted.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "message.recipients.count > 1 & recipients.target_server = same",
      "post_cond": "message.copies_transmitted = 1",
      "actions": [
        "send_single_copy_to_shared_server"
      ],
      "modality": "should",
      "id": "N-S097-009"
    },
    {
      "statement_id": "N-S097-10",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "smtp_fsm",
      "description": "That is, the SMTP client SHOULD use the command sequence: MAIL, RCPT, RCPT, ..., RCPT, DATA instead of the sequence: MAIL, RCPT, DATA, ..., MAIL, RCPT, DATA.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S097",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "send_to_multiple_recipients_same_server",
      "pre_cond": "message.recipients.count > 1 & recipients.target_server = same",
      "post_cond": null,
      "actions": [
        "issue_MAIL",
        "issue_RCPT_per_recipient",
        "issue_DATA"
      ],
      "modality": "should",
      "id": "N-S097-010"
    },
    {
