      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "smtp_fsm",
      "description": "Any system that includes an SMTP server supporting mail relaying or delivery MUST support the reserved mailbox \"postmaster\" as a case-insensitive local name.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S074",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "server.supports_mail_relaying_or_delivery = true",
      "post_cond": null,
      "actions": [
        "support_postmaster_mailbox_case_insensitive"
      ],
      "modality": "must",
      "id": "N-S074-003"
    },
    {
      "statement_id": "4-S074-4",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "smtp_fsm",
      "description": "The requirement to accept mail for postmaster implies that RCPT commands that specify a mailbox for postmaster at any of the domains for which the SMTP server provides mail service, as well as the special case of \"RCPT TO:<Postmaster>\" (with no domain specification), MUST be supported.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S074",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "RCPT_TO_postmaster_received",
      "pre_cond": "server.provides_mail_service_for_domain = true | rcpt.domain = null",
      "post_cond": "rcpt.postmaster_accepted = true",
      "actions": [
        "accept_RCPT_TO_postmaster_at_served_domain",
        "accept_RCPT_TO_postmaster_without_domain"
      ],
      "modality": "must",
      "id": "N-S074-004"
    },
    {
      "statement_id": "5-S074-5",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "smtp_fsm",
      "description": "In extreme cases -- such as to contain a denial of service attack or other breach of security -- an SMTP server may block mail directed to Postmaster.",
