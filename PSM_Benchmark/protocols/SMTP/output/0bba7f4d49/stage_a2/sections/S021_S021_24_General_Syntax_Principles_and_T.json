      "confidence": 1.0,
      "source_section": "S021",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "receipt_of_message_with_high_bit_set_without_negotiation",
      "pre_cond": "extension.8bit_negotiated = false & message.high_order_bit_set = true",
      "post_cond": null,
      "actions": [
        "clear_high_order_bit",
        "reject_message_as_invalid"
      ],
      "modality": "may",
      "id": "N-S021-006"
    },
    {
      "statement_id": "N-S021-7",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "smtp_fsm",
      "description": "In general, a relay SMTP SHOULD assume that the message content it has received is valid and, assuming that the envelope permits doing so, relay it without inspecting that content.",
