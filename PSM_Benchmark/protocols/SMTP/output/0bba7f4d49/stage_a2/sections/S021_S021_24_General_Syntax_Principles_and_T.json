      "confidence": 1.0,
      "source_section": "S021",
      "actors": [
        "relay"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "message_received_for_relay",
      "pre_cond": "envelope.permits_relay = true",
      "post_cond": null,
      "actions": [
        "assume_content_valid",
        "relay_message_without_content_inspection"
      ],
      "modality": "should",
      "id": "N-S021-007"
    },
