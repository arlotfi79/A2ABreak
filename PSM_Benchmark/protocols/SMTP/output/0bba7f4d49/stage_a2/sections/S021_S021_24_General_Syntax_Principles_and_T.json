      "category": "BEHAVIORAL",
      "subject": "smtp",
      "stage": "smtp_fsm",
      "description": "The local-part of a mailbox MUST BE treated as case sensitive.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S021",
