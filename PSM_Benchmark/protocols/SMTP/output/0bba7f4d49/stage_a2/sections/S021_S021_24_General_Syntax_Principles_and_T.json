      "to_state": null,
      "trigger": "message_transmission_attempt",
      "pre_cond": "extension.8bit_negotiated = false",
      "post_cond": null,
      "actions": [
        "prohibit_transmission_of_high_order_bit_content"
      ],
      "modality": "must",
      "id": "N-S021-005"
    },
    {
      "statement_id": "N-S021-6",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "smtp_fsm",
      "description": "If such messages are transmitted in violation of this rule, receiving SMTP servers MAY clear the high-order bit or reject the message as invalid.",
