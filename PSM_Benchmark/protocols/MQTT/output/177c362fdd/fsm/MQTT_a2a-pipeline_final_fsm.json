    "ConnectedTlsKnown",
    "Connected",
    "ChallengeSent",
    "Reauthenticating",
    "OngoingSession",
    "CurrentSession",
    "ExistingSessionContinued",
    "SessionMaintained",
    "NotConnected",
    "ConnectionRefused",
    "ConnectionRejected",
