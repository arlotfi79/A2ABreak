      "trigger": "PUBLISH_received",
      "pre_cond": "authorization.result = not_authorized & publish.qos >= 1",
      "post_cond": "error_response.sent = true",
      "actions": [
        "send PUBACK with reason_code=0x87 if QoS=1",
        "send PUBREC with reason_code=0x87 if QoS=2"
      ],
      "modality": "must"
    },
