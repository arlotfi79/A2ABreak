    {
      "statement_id": "N-S027-8",
      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "mqtt_fsm",
      "description": "If reauthenticating during the current TLS session, the Client MUST NOT use the method described in Section 2.2.4.2.1, i.e., proof of possession using a challenge from the TLS session, to avoid reusing the same challenge value from the TLS-Exporter.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S027",
      "actors": [
        "Client"
      ],
      "from_state": "Reauthenticating",
      "to_state": null,
      "trigger": null,
      "pre_cond": "client.state = Reauthenticating & tls_session = current",
      "post_cond": "pop_method != TLS_Exporter_challenge",
      "actions": [
        "do not use TLS-Exporter PoP method (Section 2.2.4.2.1)"
      ],
      "modality": "must",
      "id": "N-S027-008"
    },
    {
      "statement_id": "N-S027-9",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "client",
      "stage": "mqtt_fsm",
      "description": "For reauthentications in the same TLS-session, the Client MUST use the challenge-response PoP, as defined in Section 2.2.4.2.2.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S027",
      "actors": [
        "Client"
      ],
      "from_state": "Reauthenticating",
      "to_state": null,
      "trigger": null,
      "pre_cond": "client.state = Reauthenticating & tls_session = same",
      "post_cond": "pop_method = challenge_response_PoP",
      "actions": [
        "use challenge-response PoP as defined in Section 2.2.4.2.2"
      ],
      "modality": "must",
      "id": "N-S027-009"
    },
    {
      "statement_id": "N-S027-10",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "mqtt_fsm",
      "description": "Otherwise, the Broker MUST deny the request.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S027",
      "actors": [
        "Broker"
      ],
      "from_state": "Reauthenticating",
      "to_state": null,
      "trigger": "reauthentication_request_received",
      "pre_cond": "!client.token_submitted_with_pop",
      "post_cond": "reauthentication_request_denied = true",
      "actions": [
