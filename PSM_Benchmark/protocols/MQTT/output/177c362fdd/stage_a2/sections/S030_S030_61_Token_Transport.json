      "pre_cond": null,
      "post_cond": "(session.state = new & CONNACK.session_present = 0) | (session.state = resumed & CONNACK.session_present = 1)",
      "actions": [
        "set Session Present = 0 in CONNACK if new Session",
        "set Session Present = 1 in CONNACK if existing Session is continued"
      ],
      "modality": "must",
