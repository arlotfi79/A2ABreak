      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "However, this type of key is not required to be globally unique, so the same key MAY refer to different articles on different servers.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S041",
      "actors": [
