      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "The server MUST ensure that article numbers are issued in order of arrival timestamp; that is, articles arriving later MUST have higher numbers than those that arrive earlier.",
