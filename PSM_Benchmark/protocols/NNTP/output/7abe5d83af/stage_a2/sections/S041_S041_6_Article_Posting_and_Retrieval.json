      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "nntp_fsm",
      "description": "An article can be cross-posted to multiple newsgroups, so there may be multiple keys that point to the same article on the same server; these MAY have different numbers in each newsgroup.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S041",
      "actors": [
