      "normative_level": "MUST NOT",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "nntp_fsm",
      "description": "In order to meet the general requirements of NNTP, an article MUST NOT include the octet NUL, MUST NOT contain the octets LF and CR other than as part of a CRLF pair, and MUST end with a CRLF pair.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S019",
