      "normative_level": "SHOULD NOT",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "nntp_fsm",
      "description": "Header lines SHOULD NOT be folded before the space after the colon that follows the header name and SHOULD include at least one octet other than %x09 or %x20 between CRLF pairs.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S019",
