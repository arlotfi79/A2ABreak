      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "endpoint",
      "stage": "nntp_fsm",
      "description": "However, if an article that fails to satisfy this requirement has been received from elsewhere, clients and servers MAY transfer it to each other without re-folding it.",
