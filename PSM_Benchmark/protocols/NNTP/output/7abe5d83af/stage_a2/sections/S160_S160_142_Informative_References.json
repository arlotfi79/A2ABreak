    },
    {
      "statement_id": "N-S160-3",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "If the server is also conforming to another specification that contains a definition of message-id compatible with this one, the server SHOULD use those message-ids.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "should",
      "id": "N-S160-003"
    },
    {
      "statement_id": "N-S160-4",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "A common approach, and one that SHOULD be used for email and Netnews articles, is to extract the message-id from the contents of a header with name \"Message-ID\".",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": null,
      "post_cond": null,
      "actions": [],
      "modality": "should",
      "id": "N-S160-004"
    },
    {
      "statement_id": "N-S160-5",
      "normative_level": "MAY",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "The server MAY either use it or determine one from the article contents.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "ihave_article_received",
      "pre_cond": "command.name = IHAVE",
      "post_cond": "article.message_id != null",
      "actions": [
        "use_message_id_provided_with_ihave_command_or_determine_from_article_contents"
      ],
      "modality": "may",
      "id": "N-S160-005"
    },
    {
      "statement_id": "N-S160-6",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "However, whichever it does, it SHOULD ensure that, if the IHAVE command is repeated with the same argument and article, it will be recognized as a duplicate.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "ihave_command_received",
      "pre_cond": "command.name = IHAVE & command.argument = previous_ihave.argument & article.contents = previous_ihave.article.contents",
      "post_cond": "article.recognized_as_duplicate = true",
      "actions": [
        "recognize_repeated_ihave_article_as_duplicate"
      ],
      "modality": "should",
      "id": "N-S160-006"
    },
    {
      "statement_id": "N-S160-7",
      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "If an article does not contain a message-id that the server can identify, it MUST synthesize one.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "article_received_without_identifiable_message_id",
      "pre_cond": "!server.can_identify_message_id(article)",
      "post_cond": "article.message_id != null",
      "actions": [
        "synthesize_message_id_for_article"
      ],
      "modality": "must",
      "id": "N-S160-007"
    },
    {
      "statement_id": "N-S160-8",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "When email or Netnews articles are handled, a Message-ID header SHOULD be added to ensure global consistency and uniqueness.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "email_or_netnews_article_processed",
      "pre_cond": "article.type = email | article.type = netnews",
      "post_cond": "article.has_message_id_header = true",
      "actions": [
        "add_message_id_header_to_article"
      ],
      "modality": "should",
      "id": "N-S160-008"
    },
    {
      "statement_id": "N-S160-9",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "It is expected that the client will already have done any necessary validation (or that it has in turn obtained the article from a third party that has done so); therefore, the contents SHOULD be left unchanged.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server",
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "ihave_article_received",
      "pre_cond": "command.name = IHAVE",
      "post_cond": "article.contents_unmodified = true",
      "actions": [
        "preserve_article_contents_unchanged"
      ],
      "modality": "should",
      "id": "N-S160-009"
    },
    {
      "statement_id": "N-S160-10",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "This is often done by a separate piece of software on the server installation; if so, the NNTP server SHOULD pass the incoming article to that software unaltered, making no attempt to filter characters, to fold or limit lines, or to process the incoming text otherwise.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "post_article_received",
      "pre_cond": "command.name = POST & server.uses_separate_validation_software = true",
      "post_cond": "article.passed_to_software_unaltered = true",
      "actions": [
        "pass_article_to_validation_software_unaltered"
      ],
      "modality": "should",
      "id": "N-S160-010"
    },
    {
      "statement_id": "N-S160-11",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "nntp_fsm",
      "description": "In the case of email or Netnews articles, therefore, the posted article SHOULD contain a header with the name \"Message-ID\", and the contents of this header SHOULD be identical on each attempt.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "client"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "post_command_submitted",
      "pre_cond": "article.type = email | article.type = netnews",
      "post_cond": "article.has_message_id_header = true & article.message_id_header_value = prior_attempt.message_id_header_value",
      "actions": [
        "include_message_id_header_in_posted_article",
        "use_same_message_id_header_value_on_each_post_retry"
      ],
      "modality": "should",
      "id": "N-S160-011"
    },
    {
      "statement_id": "N-S160-12",
      "normative_level": "SHOULD",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "The server SHOULD ensure that two POSTed articles with the same contents for this header are recognized as identical and that the same message-id is allocated, whether or not those contents are suitable for use as the message-id.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": "post_article_received",
      "pre_cond": "command.name = POST & article.message_id_header_value = previous_post.message_id_header_value",
      "post_cond": "article.recognized_as_duplicate = true & article.allocated_message_id = previous_post.allocated_message_id",
      "actions": [
        "recognize_duplicate_posted_articles",
        "allocate_same_message_id_to_duplicate_post"
      ],
      "modality": "should",
      "id": "N-S160-012"
