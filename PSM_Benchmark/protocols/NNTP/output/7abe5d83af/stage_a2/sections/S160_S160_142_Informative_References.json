      "normative_level": "MUST",
      "category": "BEHAVIORAL",
      "subject": "server",
      "stage": "nntp_fsm",
      "description": "Every article handled by an NNTP server MUST have a unique message-id.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S160",
      "actors": [
        "server"
      ],
