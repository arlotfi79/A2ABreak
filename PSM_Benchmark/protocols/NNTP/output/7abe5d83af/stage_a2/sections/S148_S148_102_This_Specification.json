      "category": "BEHAVIORAL",
      "subject": "message",
      "stage": "nntp_fsm",
      "description": "Header values SHOULD use US-ASCII or an encoding based on it, such as RFC 2047 [RFC2047], until such time as another approach has been standardised.",
      "is_inferred": false,
      "confidence": 1.0,
      "source_section": "S148",
