# Alloy is downloaded by run_all.sh and verified against its pin. Its upstream
# release tag (v6.2.0) is immutable, so the pin holds and the 21 MB jar does not
# need to live in the repository.
alloy.jar

# tla2tools.jar is the exception and IS committed. The tlaplus "v1.8.0" tag is a
# rolling prerelease whose asset upstream replaces in place, so a URL plus a
# checksum is not a durable pin -- the build this artifact was developed against
# was replaced on 2026-09-17 and is gone. Vendoring the jar keeps the formal
# verification runnable offline and immune to further upstream drift.
!tla2tools.jar
