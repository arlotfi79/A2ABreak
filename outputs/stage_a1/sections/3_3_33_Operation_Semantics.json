      "normative_level": "DEFINITION",
      "category": "IMPLICIT_TRANSITION",
      "subject": "server",
      "stage": "task_execution",
      "description": "Servers MUST return a not found error when a requested resource does not exist or is not accessible to the authenticated client. Servers SHOULD NOT distinguish between 'does not exist' and 'not authorized' to prevent information leakage.",
      "is_inferred": false,
      "confidence": 0.8,
      "source_section": "3.3.2",
      "actors": [
        "client",
        "server"
      ],
      "from_state": null,
      "to_state": null,
      "trigger": null,
      "pre_cond": "!resource.exists | !resource.accessible_to_client",
      "post_cond": "resource_not_found_error.returned = true",
      "actions": [
        "Server returns not found error without distinguishing between non-existent and unauthorized resource"
      ],
      "modality": "must"
    },
