      "source_section": "A.2.1",
      "object_name": "Part",
      "field_name": null,
      "field_type": null,
      "required": null,
      "allowed_values": [
        "text",
        "raw",
        "url",
        "data"
      ],
      "guard_semantics": "exactly one of allowed_values must be present as the top-level member name discriminator identifying the Part subtype; becomes NuXMV INVAR not a per-transition guard"
    },
