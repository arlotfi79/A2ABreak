digraph interruption {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    // States
    "TASK_STATE_INPUT_REQUIRED" [fontname="Helvetica", fontsize="10", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", label="TASK_STATE_INPUT\nREQUIRED"];
    "TASK_STATE_AUTH_REQUIRED" [fontname="Helvetica", fontsize="10", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", label="TASK_STATE_AUTH\nREQUIRED"];
    "TASK_STATE_WORKING" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="TASK_STATE_WORKING"];
    "TASK_STATE_CANCELED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_CANCELED"];
    "STREAM_STATE_OPEN" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="STREAM_STATE_OPEN"];
    "STREAM_STATE_CLOSED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="STREAM_STATE_CLOSED"];

    // Inter-stage: entry from previous stage
    "__ENTRY__" [shape=hexagon, label="← prev stage", style=filled, fillcolor="#cce5ff", color="#004085", fontname="Helvetica", fontsize=9];
    "__ENTRY__" -> "TASK_STATE_WORKING" [style=dotted, color="#004085", arrowsize=0.7];

    // Inter-stage: exit to next stage
    "__EXIT__" [shape=hexagon, label="next stage →", style=filled, fillcolor="#fff3cd", color="#856404", fontname="Helvetica", fontsize=9];
    "TASK_STATE_WORKING" -> "__EXIT__" [style=dotted, color="#856404", arrowsize=0.7, label="task_execution"];
    "TASK_STATE_CANCELED" -> "__EXIT__" [style=dotted, color="#856404", arrowsize=0.7, label="termination"];

    // Transitions
    "TASK_STATE_WORKING" -> "TASK_STATE_INPUT_REQUIRED" [label="agent_requests_input\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_required\n[!(authorization.negotiated_out_of_band = true |\nauthorization.negotiated_via_extension = true)]", style=solid, color="#dc3545", fontcolor="#dc3545"];
    "TASK_STATE_INPUT_REQUIRED" -> "TASK_STATE_WORKING" [label="client_sends_input\n[task.state = TASK_STATE_INPUT_REQUIRED & message.taskId = task.id &\nmessage.contextId = task.contextId]", style=dashed, color="#666666", fontcolor="#666666"];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_WORKING" [label="credential_received\n[task.state = TASK_STATE_AUTH_REQUIRED & credential_received_out_of_band\n= true]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_AUTH_REQUIRED" [label="message_received\n[task.state = TASK_STATE_AUTH_REQUIRED]", style=solid, color="#fd7e14", fontcolor="#fd7e14"];
    "TASK_STATE_INPUT_REQUIRED" -> "TASK_STATE_CANCELED" [label="cancel_task_requested\n[!task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_CANCELED" [label="cancel_task_requested\n[!task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_delegation\n[client.is_a2a_agent = true & client.is_actively_processing_task = true &\nreceived_task.state = TASK_STATE_AUTH_REQUIRED]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_delegation_required\n[client.is_a2a_agent = true & client.task.is_actively_being_processed =\ntrue]", style=dashed, color="#fd7e14", fontcolor="#fd7e14"];
    "STREAM_STATE_OPEN" -> "STREAM_STATE_CLOSED" [label="task_reached_terminal_or_interrupted_state\n[stream.open = true & (task.state = terminal | task.state = interrupted)]", style=solid, color="#dc3545", fontcolor="#dc3545"];

    // Legend
    subgraph cluster_legend {
        label="Legend"; fontsize=9; fontname="Helvetica";
        style=dotted; color="#aaaaaa";
        node [fontsize=8, fontname="Helvetica"];
        L1 [shape=doublecircle, label="initial",    style=filled, fillcolor="#d4edda", color="#28a745"];
        L2 [shape=rectangle,   label="terminal",   style=filled, fillcolor="#f8d7da", color="#dc3545"];
        L3 [shape=diamond,     label="error",      style=filled, fillcolor="#fff3cd", color="#fd7e14"];
        L4 [shape=ellipse,     label="interrupted",style=filled, fillcolor="#cce5ff", color="#004085"];
        L5 [shape=circle,      label="intermediate"];
        L6 [shape=circle,      label="inferred",   style=dashed];
        L1 -> L2 [label="must",   color="#dc3545", fontcolor="#dc3545", fontsize=8];
        L2 -> L3 [label="should",  color="#fd7e14", fontcolor="#fd7e14", fontsize=8];
        L3 -> L4 [label="may",    color="#28a745", fontcolor="#28a745", fontsize=8];
        L4 -> L5 [label="inferred",style=dashed,   color="#666666",    fontsize=8];
        L5 -> L6 [style=invis];
    }

}