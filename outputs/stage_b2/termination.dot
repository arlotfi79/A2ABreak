digraph termination {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    // States
    "TASK_STATE_COMPLETED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_COMPLETED"];
    "TASK_STATE_FAILED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_FAILED"];
    "TASK_STATE_CANCELED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_CANCELED"];
    "TASK_STATE_REJECTED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_REJECTED"];
    "STREAM_CLOSED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="STREAM_CLOSED"];
    "TASK_STATE_WORKING" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="TASK_STATE_WORKING"];
    "submitted" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="submitted"];
    "STREAM_OPEN" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="STREAM_OPEN"];
    "STREAM_ACTIVE" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="STREAM_ACTIVE"];
    "TASK_STATE_TERMINAL" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_TERMINAL"];
    "STREAM_STATE_OPEN" [fontname="Helvetica", fontsize="10", shape="circle", style="dashed", label="STREAM_STATE_OPEN"];
    "STREAM_STATE_CLOSED" [fontname="Helvetica", fontsize="10", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="STREAM_STATE_CLOSED"];

    // Inter-stage: entry from previous stage
    "__ENTRY__" [shape=hexagon, label="← prev stage", style=filled, fillcolor="#cce5ff", color="#004085", fontname="Helvetica", fontsize=9];
    "__ENTRY__" -> "TASK_STATE_WORKING" [style=dotted, color="#004085", arrowsize=0.7];
    "__ENTRY__" -> "submitted" [style=dotted, color="#004085", arrowsize=0.7];
    "__ENTRY__" -> "STREAM_OPEN" [style=dotted, color="#004085", arrowsize=0.7];
    "__ENTRY__" -> "STREAM_ACTIVE" [style=dotted, color="#004085", arrowsize=0.7];
    "__ENTRY__" -> "STREAM_STATE_OPEN" [style=dotted, color="#004085", arrowsize=0.7];

    // Transitions
    "STREAM_OPEN" -> "STREAM_CLOSED" [label="task_reached_terminal_state\n[stream.open = true & !task.state.is_terminal]", style=solid, color="#dc3545", fontcolor="#dc3545"];
    "STREAM_ACTIVE" -> "STREAM_CLOSED" [label="stream_close\n[stream.state = STREAM_ACTIVE]", style=solid, color="#333333", fontcolor="#333333"];
    "TASK_STATE_WORKING" -> "TASK_STATE_COMPLETED" [label="statusUpdate\n[task.state = TASK_STATE_WORKING & stream.open = true]", style=solid, color="#333333", fontcolor="#333333"];
    "submitted" -> "TASK_STATE_COMPLETED" [label="task_processing_complete\n[task.pushNotificationConfig.url != null & task.status.state !=\nTASK_STATE_COMPLETED]", style=solid, color="#333333", fontcolor="#333333"];
    "STREAM_STATE_OPEN" -> "STREAM_STATE_CLOSED" [label="task_reached_terminal_or_interrupted_state\n[stream.open = true & (task.state = terminal | task.state = interrupted)]", style=solid, color="#dc3545", fontcolor="#dc3545"];
    "TASK_STATE_TERMINAL" -> "TASK_STATE_TERMINAL" [label="cancel_task\n[task.state = TASK_STATE_COMPLETED | task.state = TASK_STATE_FAILED |\ntask.state = TASK_STATE_CANCELED]", style=dashed, color="#666666", fontcolor="#666666"];
    "TASK_STATE_CANCELED" -> "TASK_STATE_CANCELED" [label="cancel_task_after_purge\n[task.canceled = true & task.purged = true]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "TASK_STATE_WORKING" -> "TASK_STATE_FAILED" [label="task_processing_failed\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#666666", fontcolor="#666666"];
    "TASK_STATE_WORKING" -> "TASK_STATE_CANCELED" [label="cancel_task\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#666666", fontcolor="#666666"];
    "TASK_STATE_WORKING" -> "TASK_STATE_REJECTED" [label="agent_rejects_task\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#28a745", fontcolor="#28a745"];
    "submitted" -> "TASK_STATE_REJECTED" [label="agent_rejects_task", style=dashed, color="#28a745", fontcolor="#28a745"];
    "submitted" -> "TASK_STATE_CANCELED" [label="cancel_task\n[task.status.state = submitted]", style=dashed, color="#666666", fontcolor="#666666"];

    // Legend
    subgraph cluster_legend {
        label="Legend"; fontsize=9; fontname="Helvetica";
        style=dotted; color="#aaaaaa";
        node [fontsize=8, fontname="Helvetica"];
        L1 [shape=doublecircle, label="initial",    style=filled, fillcolor="#d4edda", color="#28a745"];
        L2 [shape=rectangle,   label="terminal",   style=filled, fillcolor="#f8d7da", color="#dc3545"];
        L3 [shape=diamond,     label="error",      style=filled, fillcolor="#fff3cd", color="#fd7e14"];
        L4 [shape=ellipse,     label="interrupted",style=filled, fillcolor="#cce5ff", color="#004085"];
        L5 [shape=circle,      label="intermediate"];
        L6 [shape=circle,      label="inferred",   style=dashed];
        L1 -> L2 [label="must",   color="#dc3545", fontcolor="#dc3545", fontsize=8];
        L2 -> L3 [label="should",  color="#fd7e14", fontcolor="#fd7e14", fontsize=8];
        L3 -> L4 [label="may",    color="#28a745", fontcolor="#28a745", fontsize=8];
        L4 -> L5 [label="inferred",style=dashed,   color="#666666",    fontsize=8];
        L5 -> L6 [style=invis];
    }

}