digraph unified_fsm {
    rankdir=LR;
    size="4,8";
    ratio=compress;
    margin=0.05;
    dpi=300;
    nodesep=0.30;
    ranksep=0.55;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=24];
    edge [fontname="Helvetica", fontsize=18];

    // States
    "AGENT_CARD_CACHE_EXPIRED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="AGENT_CARD_CACHE\nEXPIRED"];
    "AGENT_CARD_CACHE_VALID" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="AGENT_CARD_CACHE\nVALID"];
    "AGENT_CARD_RECEIVED" [fontname="Helvetica", fontsize="24", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#28a745", label="AGENT_CARD_RECEIVED"];
    "CLIENT_AUTH_DISCOVERY" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="CLIENT_AUTH\nDISCOVERY"];
    "CLIENT_CREDENTIAL_ACQUISITION" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="CLIENT_CREDENTIAL\nACQUISITION"];
    "EXTENDED_CARD_NOT_CONFIGURED" [fontname="Helvetica", fontsize="24", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="EXTENDED_CARD_NOT\nCONFIGURED"];
    "EXTENDED_CARD_UNSUPPORTED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="EXTENDED_CARD\nUNSUPPORTED"];
    "TRANSPORT_CONNECTED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="TRANSPORT_CONNECTED"];
    "TRANSPORT_SELECTED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="TRANSPORT_SELECTED"];
    "AUTHENTICATION_FAILED" [fontname="Helvetica", fontsize="24", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="AUTHENTICATION\nFAILED"];
    "AUTHORIZATION_DENIED" [fontname="Helvetica", fontsize="24", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="AUTHORIZATION_DENIED"];
    "CLIENT_CREDENTIAL_TRANSMISSION" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="CLIENT_CREDENTIAL\nTRANSMISSION"];
    "REQUEST_AUTHORIZED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="REQUEST_AUTHORIZED"];
    "SERVER_IDENTITY_VERIFIED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="SERVER_IDENTITY\nVERIFIED"];
    "SERVER_VALIDATING_REQUEST" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="SERVER_VALIDATING\nREQUEST"];
    "TASK_STATE_AUTH_REQUIRED" [fontname="Helvetica", fontsize="24", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", label="TASK_STATE_AUTH\nREQUIRED"];
    "TLS_HANDSHAKE_INITIATED" [fontname="Helvetica", fontsize="24", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#28a745", label="TLS_HANDSHAKE\nINITIATED"];
    "authenticated" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="authenticated"];
    "STREAM_CLOSED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="STREAM_CLOSED"];
    "STREAM_STATE_OPEN" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="STREAM_STATE_OPEN"];
    "TASK_STATE_NONEXISTENT" [fontname="Helvetica", fontsize="24", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#28a745", label="TASK_STATE\nNONEXISTENT"];
    "TASK_STATE_REJECTED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_REJECTED"];
    "TASK_STATE_SUBMITTED" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="TASK_STATE_SUBMITTED"];
    "TASK_STATE_WORKING" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="TASK_STATE_WORKING"];
    "VERSION_NEGOTIATION_ERROR" [fontname="Helvetica", fontsize="24", shape="diamond", style="filled", fillcolor="#fff3cd", color="#fd7e14", label="VERSION_NEGOTIATION\nERROR"];
    "PUSH_NOTIFICATION_ACKNOWLEDGED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="PUSH_NOTIFICATION\nACKNOWLEDGED"];
    "PUSH_NOTIFICATION_CONFIG_ACTIVE" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="PUSH_NOTIFICATION\nCONFIG_ACTIVE"];
    "PUSH_NOTIFICATION_CONFIG_DELETED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="PUSH_NOTIFICATION\nCONFIG_DELETED"];
    "PUSH_NOTIFICATION_DELIVERY_ABANDONED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="PUSH_NOTIFICATION\nDELIVERY_ABANDONED"];
    "PUSH_NOTIFICATION_DELIVERY_RETRYING" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="PUSH_NOTIFICATION\nDELIVERY_RETRYING"];
    "PUSH_NOTIFICATION_RECEIVED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="PUSH_NOTIFICATION\nRECEIVED"];
    "STREAM_ACTIVE" [fontname="Helvetica", fontsize="24", shape="circle", style="solid", label="STREAM_ACTIVE"];
    "SUBSCRIBE_TO_TASK_REQUESTED" [fontname="Helvetica", fontsize="24", shape="circle", style="dashed", label="SUBSCRIBE_TO_TASK\nREQUESTED"];
    "TASK_STATE_CANCELED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled,dashed", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_CANCELED"];
    "TASK_STATE_COMPLETED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_COMPLETED"];
    "TASK_STATE_FAILED" [fontname="Helvetica", fontsize="24", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="TASK_STATE_FAILED"];
    "TASK_STATE_INPUT_REQUIRED" [fontname="Helvetica", fontsize="24", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", label="TASK_STATE_INPUT\nREQUIRED"];

    // Transitions (inter_stage = purple; intra = modality colors)
    "AGENT_CARD_RECEIVED" -> "TRANSPORT_SELECTED" [label="supportedInterfaces_parsed\n[agent_card.supportedInterfaces != null]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "AGENT_CARD_RECEIVED" -> "TRANSPORT_SELECTED" [label="protocol_selection\n[agent_card.supported_protocols != null]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TRANSPORT_SELECTED" -> "TRANSPORT_CONNECTED" [label="transport_url_resolved\n[client.selectedTransport != null]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TRANSPORT_CONNECTED" -> "CLIENT_AUTH_DISCOVERY" [label="auth_discovery_initiated", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "CLIENT_AUTH_DISCOVERY" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="security_scheme_parsed\n[agent_card.securitySchemes != null]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "AGENT_CARD_RECEIVED" -> "EXTENDED_CARD_UNSUPPORTED" [label="get_extended_agent_card_request\n[agent_card.capabilities.extendedAgentCard = false |\n!agent_card.capabilities.extendedAgentCard]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "AGENT_CARD_RECEIVED" -> "EXTENDED_CARD_NOT_CONFIGURED" [label="get_extended_agent_card_request\n[agent_card.capabilities.extendedAgentCard = true &\nagent_card.extended_card_configured = false]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "AGENT_CARD_RECEIVED" -> "AGENT_CARD_CACHE_VALID" [label="agent_card_fetch", style=dashed, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "AGENT_CARD_CACHE_VALID" -> "AGENT_CARD_CACHE_EXPIRED" [label="cache_ttl_expired\n[agent_card.cache_expired = true]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "AGENT_CARD_CACHE_EXPIRED" -> "AGENT_CARD_RECEIVED" [label="agent_card_cache_expired\n[agent_card.cached = true & agent_card.cache_expired = true]", style=dashed, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "TLS_HANDSHAKE_INITIATED" -> "SERVER_IDENTITY_VERIFIED" [label="tls_certificate_validated\n[client.server_identity_verified = true]", style=dashed, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "SERVER_IDENTITY_VERIFIED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="auth_requirements_discovered", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "CLIENT_CREDENTIAL_ACQUISITION" -> "CLIENT_CREDENTIAL_TRANSMISSION" [label="credentials_acquired\n[client.credentials_acquired = true]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "CLIENT_CREDENTIAL_TRANSMISSION" -> "SERVER_VALIDATING_REQUEST" [label="request_received", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "CLIENT_CREDENTIAL_TRANSMISSION" -> "SERVER_VALIDATING_REQUEST" [label="get_extended_agent_card_request\n[request.auth_scheme matches agent_card.securitySchemes]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "SERVER_VALIDATING_REQUEST" -> "authenticated" [label="credentials_validated\n[request.authenticated = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "SERVER_VALIDATING_REQUEST" -> "AUTHENTICATION_FAILED" [label="authentication_challenge_or_rejection\n[request.credentials.valid = false | request.credentials = null]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "SERVER_VALIDATING_REQUEST" -> "AUTHENTICATION_FAILED" [label="authentication_error", style=dashed, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="request_received\n[client.permissions.sufficient = true]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="A2A_protocol_operations_request\n[caller.authenticated = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="get_extended_agent_card_request\n[client.authenticated = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "authenticated" -> "AUTHORIZATION_DENIED" [label="request_received\n[client.authenticated = true & client.permissions.sufficient = false]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "AUTHENTICATION_FAILED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="authentication_retry\n[response.authentication_challenge_info = present]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_AUTH_REQUIRED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="secondary_credentials_requested", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_WORKING" [label="send_message_requested", style=solid, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_WORKING" [label="send_message_request_received\n[configuration.returnImmediately = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_WORKING" [label="POST /message:stream", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "STREAM_STATE_OPEN" -> "STREAM_CLOSED" [label="message_delivered\n[stream.open = true & stream.mode = MESSAGE_ONLY]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "STREAM_STATE_OPEN" -> "STREAM_CLOSED" [label="task_reached_terminal_or_interrupted_state\n[stream.open = true & (task.state = terminal | task.state = interrupted)]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "STREAM_STATE_OPEN" -> "STREAM_CLOSED" [label="task_reached_terminal_state\n[stream.open = true & !task.state.is_terminal]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_NONEXISTENT" [label="agent_sends_clarification_message\n[task.created = false]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "TASK_STATE_REJECTED" [label="agent_rejects_task\n[task.state = TASK_STATE_SUBMITTED]", style=solid, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "VERSION_NEGOTIATION_ERROR" [label="message_send_request_received\n[request.A2A_Version != null & server.version_supported = false]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "VERSION_NEGOTIATION_ERROR" [label="request_received\n[!server.version_supported]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_SUBMITTED" [label="message_send\n[configuration.pushNotificationConfig != null &\nconfiguration.pushNotificationConfig.url != null]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "TASK_STATE_SUBMITTED" [label="task_creation", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_NONEXISTENT" -> "STREAM_STATE_OPEN" [label="POST_message_stream", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "TASK_STATE_WORKING" [label="agent_begins_processing\n[task.state = TASK_STATE_SUBMITTED]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_WORKING" [label="artifactUpdate\n[task.state = TASK_STATE_WORKING & stream.open = true]", style=solid, color="#333333", fontcolor="#333333", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_COMPLETED" [label="statusUpdate\n[task.state = TASK_STATE_WORKING & stream.open = true]", style=solid, color="#333333", fontcolor="#333333", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_INPUT_REQUIRED" [label="agent_requests_input\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_REJECTED" [label="agent_rejects_task\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_FAILED" [label="task_processing_failed\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_CANCELED" [label="cancel_task\n[task.state = TASK_STATE_WORKING]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_required\n[!(authorization.negotiated_out_of_band = true |\nauthorization.negotiated_via_extension = true)]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_delegation\n[client.is_a2a_agent = true & client.is_actively_processing_task = true &\nreceived_task.state = TASK_STATE_AUTH_REQUIRED]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_WORKING" -> "TASK_STATE_AUTH_REQUIRED" [label="authorization_delegation_required\n[client.is_a2a_agent = true & client.task.is_actively_being_processed =\ntrue]", style=dashed, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "TASK_STATE_INPUT_REQUIRED" -> "TASK_STATE_WORKING" [label="message_received\n[task.state = TASK_STATE_INPUT_REQUIRED & message.taskId = task.taskId &\nmessage.contextId = task.contextId]", style=solid, color="#333333", fontcolor="#333333", penwidth=1];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_WORKING" [label="credential_received\n[task.state = TASK_STATE_AUTH_REQUIRED & credential_received_out_of_band\n= true]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "SUBSCRIBE_TO_TASK_REQUESTED" -> "STREAM_STATE_OPEN" [label="subscribe_to_task_requested\n[!task.state.is_terminal]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "STREAM_STATE_OPEN" -> "STREAM_ACTIVE" [label="stream_open", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "STREAM_ACTIVE" -> "STREAM_ACTIVE" [label="task_event_generated\n[stream.state = STREAM_ACTIVE]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "STREAM_ACTIVE" -> "STREAM_CLOSED" [label="task_reaches_terminal_or_interrupted_state\n[task.state IN (TASK_STATE_COMPLETED, TASK_STATE_FAILED,\nTASK_STATE_CANCELED, TASK_STATE_REJECTED, TASK_STATE_INPUT_REQUIRED,\nTASK_STATE_AUTH_REQUIRED)]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "STREAM_ACTIVE" -> "STREAM_CLOSED" [label="stream_close\n[stream.state = STREAM_ACTIVE]", style=solid, color="#333333", fontcolor="#333333", penwidth=1];
    "PUSH_NOTIFICATION_CONFIG_ACTIVE" -> "PUSH_NOTIFICATION_CONFIG_DELETED" [label="delete_push_notification_config_requested\n[push_notification_config.exists = true AND\nagent.supports_push_notifications = true]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "PUSH_NOTIFICATION_DELIVERY_RETRYING" -> "PUSH_NOTIFICATION_DELIVERY_ABANDONED" [label="consecutive_delivery_failures_threshold_reached\n[push_notification.consecutive_failures >=\npush_notification.configured_failure_limit]", style=solid, color="#28a745", fontcolor="#28a745", penwidth=1];
    "PUSH_NOTIFICATION_RECEIVED" -> "PUSH_NOTIFICATION_ACKNOWLEDGED" [label="webhook_request_received\n[webhook_request received with authentication credentials present]", style=solid, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_AUTH_REQUIRED" [label="message_received\n[task.state = TASK_STATE_AUTH_REQUIRED]", style=solid, color="#fd7e14", fontcolor="#fd7e14", penwidth=1];
    "TASK_STATE_INPUT_REQUIRED" -> "TASK_STATE_CANCELED" [label="cancel_task_requested\n[!task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_AUTH_REQUIRED" -> "TASK_STATE_CANCELED" [label="cancel_task_requested\n[!task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "TASK_STATE_COMPLETED" [label="task_processing_complete\n[task.pushNotificationConfig.url != null & task.status.state !=\nTASK_STATE_COMPLETED]", style=solid, color="#333333", fontcolor="#333333", penwidth=1];
    "TASK_STATE_CANCELED" -> "TASK_STATE_CANCELED" [label="cancel_task_after_purge\n[task.canceled = true & task.purged = true]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "TASK_STATE_CANCELED" [label="cancel_task\n[task.status.state = submitted]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "CLIENT_CREDENTIAL_ACQUISITION" -> "TLS_HANDSHAKE_INITIATED" [label="transport_security_initiated\n[client.required_auth_scheme != null]", style=dashed, color="#9333ea", fontcolor="#9333ea", penwidth=2.2];
    "REQUEST_AUTHORIZED" -> "TASK_STATE_NONEXISTENT" [label="initial_message_authorized\n[client.permissions.sufficient = true]", style=dashed, color="#9333ea", fontcolor="#9333ea", penwidth=2.2];
    "TASK_STATE_COMPLETED" -> "TASK_STATE_COMPLETED" [label="cancel_task\n[task.state = TASK_STATE_COMPLETED]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_FAILED" -> "TASK_STATE_FAILED" [label="cancel_task\n[task.state = TASK_STATE_FAILED]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_CANCELED" -> "TASK_STATE_CANCELED" [label="cancel_task\n[task.state = TASK_STATE_CANCELED]", style=dashed, color="#666666", fontcolor="#666666", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "PUSH_NOTIFICATION_CONFIG_ACTIVE" [label="create_push_notification_config_requested\n[agent.capabilities.pushNotifications = true & task.exists = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_WORKING" -> "PUSH_NOTIFICATION_CONFIG_ACTIVE" [label="create_push_notification_config_requested\n[agent.capabilities.pushNotifications = true & task.exists = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];
    "TASK_STATE_SUBMITTED" -> "SUBSCRIBE_TO_TASK_REQUESTED" [label="subscribe_to_task\n[task.exists = true & !task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_WORKING" -> "SUBSCRIBE_TO_TASK_REQUESTED" [label="subscribe_to_task\n[task.exists = true & !task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_INPUT_REQUIRED" -> "SUBSCRIBE_TO_TASK_REQUESTED" [label="subscribe_to_task\n[task.exists = true & !task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "TASK_STATE_AUTH_REQUIRED" -> "SUBSCRIBE_TO_TASK_REQUESTED" [label="subscribe_to_task\n[task.exists = true & !task.state.is_terminal]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "PUSH_NOTIFICATION_CONFIG_ACTIVE" -> "PUSH_NOTIFICATION_DELIVERY_RETRYING" [label="push_notification_delivery_failed\n[push_notification_config.exists = true &\npush_notification.delivery_attempt_failed = true]", style=dashed, color="#28a745", fontcolor="#28a745", penwidth=1];
    "PUSH_NOTIFICATION_CONFIG_ACTIVE" -> "PUSH_NOTIFICATION_RECEIVED" [label="push_notification_delivered\n[push_notification_config.exists = true &\npush_notification.delivery_successful = true]", style=dashed, color="#dc3545", fontcolor="#dc3545", penwidth=1];

}