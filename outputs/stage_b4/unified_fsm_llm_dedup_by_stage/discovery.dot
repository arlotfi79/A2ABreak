digraph discovery {
    rankdir=LR;
    size="10,6";
    ratio=compress;
    margin=0.05;
    dpi=300;
    nodesep=0.45;
    ranksep=0.85;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=18];
    edge [fontname="Helvetica", fontsize=12];
    label="Discovery FSM";
    labelloc=t;
    fontsize=24;

    // States
    "AGENT_CARD_CACHE_EXPIRED" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="AGENT_CARD_CACHE\nEXPIRED"];
    "AGENT_CARD_CACHE_VALID" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="AGENT_CARD_CACHE\nVALID"];
    "AGENT_CARD_RECEIVED" [fontname="Helvetica", fontsize="18", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#28a745", label="AGENT_CARD_RECEIVED"];
    "CLIENT_AUTH_DISCOVERY" [fontname="Helvetica", fontsize="18", shape="circle", style="solid", label="CLIENT_AUTH\nDISCOVERY"];
    "CLIENT_CREDENTIAL_ACQUISITION" [fontname="Helvetica", fontsize="18", shape="circle", style="solid", label="CLIENT_CREDENTIAL\nACQUISITION"];
    "EXTENDED_CARD_NOT_CONFIGURED" [fontname="Helvetica", fontsize="18", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="EXTENDED_CARD_NOT\nCONFIGURED"];
    "EXTENDED_CARD_UNSUPPORTED" [fontname="Helvetica", fontsize="18", shape="rectangle", style="filled", fillcolor="#f8d7da", color="#dc3545", label="EXTENDED_CARD\nUNSUPPORTED"];
    "TRANSPORT_CONNECTED" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="TRANSPORT_CONNECTED"];
    "TRANSPORT_SELECTED" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="TRANSPORT_SELECTED"];
    "TLS_HANDSHAKE_INITIATED" [fontname="Helvetica", fontsize="18", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#6c757d", penwidth="2.0", label="TLS_HANDSHAKE\nINITIATED\n[boundary]"];

    // Transitions
    "AGENT_CARD_RECEIVED" -> "TRANSPORT_SELECTED" [label="supportedInterfaces_parsed\n[agent_card.supportedInterfaces != null]", style="solid", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "AGENT_CARD_RECEIVED" -> "TRANSPORT_SELECTED" [label="protocol_selection\n[agent_card.supported_protocols != null]", style="dashed", color="#28a745", fontcolor="#28a745", penwidth="1.0"];
    "TRANSPORT_SELECTED" -> "TRANSPORT_CONNECTED" [label="transport_url_resolved\n[client.selectedTransport != null]", style="solid", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "TRANSPORT_CONNECTED" -> "CLIENT_AUTH_DISCOVERY" [label="auth_discovery_initiated", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "CLIENT_AUTH_DISCOVERY" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="security_scheme_parsed\n[agent_card.securitySchemes != null]", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "AGENT_CARD_RECEIVED" -> "EXTENDED_CARD_UNSUPPORTED" [label="get_extended_agent_card_request\n[agent_card.capabilities.extendedAgentCard = false |\n!agent_card.capabilities.extendedAgentCard]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "AGENT_CARD_RECEIVED" -> "EXTENDED_CARD_NOT_CONFIGURED" [label="get_extended_agent_card_request\n[agent_card.capabilities.extendedAgentCard = true &\nagent_card.extended_card_configured = false]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "AGENT_CARD_RECEIVED" -> "AGENT_CARD_CACHE_VALID" [label="agent_card_fetch", style="dashed", color="#fd7e14", fontcolor="#fd7e14", penwidth="1.0"];
    "AGENT_CARD_CACHE_VALID" -> "AGENT_CARD_CACHE_EXPIRED" [label="cache_ttl_expired\n[agent_card.cache_expired = true]", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "AGENT_CARD_CACHE_EXPIRED" -> "AGENT_CARD_RECEIVED" [label="agent_card_cache_expired\n[agent_card.cached = true & agent_card.cache_expired =\ntrue]", style="dashed", color="#fd7e14", fontcolor="#fd7e14", penwidth="1.0"];
    "CLIENT_CREDENTIAL_ACQUISITION" -> "TLS_HANDSHAKE_INITIATED" [label="transport_security_initiated\n[client.required_auth_scheme != null]", style="dashed", color="#9333ea", fontcolor="#9333ea", penwidth="2.2"];

}