digraph authentication {
    rankdir=LR;
    size="10,6";
    ratio=compress;
    margin=0.05;
    dpi=300;
    nodesep=0.45;
    ranksep=0.85;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=18];
    edge [fontname="Helvetica", fontsize=12];
    label="Authentication FSM";
    labelloc=t;
    fontsize=24;

    // States
    "AUTHENTICATION_FAILED" [fontname="Helvetica", fontsize="18", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="AUTHENTICATION\nFAILED"];
    "AUTHORIZATION_DENIED" [fontname="Helvetica", fontsize="18", shape="diamond", style="filled,dashed", fillcolor="#fff3cd", color="#fd7e14", label="AUTHORIZATION_DENIED"];
    "CLIENT_CREDENTIAL_ACQUISITION" [fontname="Helvetica", fontsize="18", shape="circle", style="solid", label="CLIENT_CREDENTIAL\nACQUISITION"];
    "CLIENT_CREDENTIAL_TRANSMISSION" [fontname="Helvetica", fontsize="18", shape="circle", style="solid", label="CLIENT_CREDENTIAL\nTRANSMISSION"];
    "REQUEST_AUTHORIZED" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="REQUEST_AUTHORIZED"];
    "SERVER_IDENTITY_VERIFIED" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="SERVER_IDENTITY\nVERIFIED"];
    "SERVER_VALIDATING_REQUEST" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="SERVER_VALIDATING\nREQUEST"];
    "TASK_STATE_AUTH_REQUIRED" [fontname="Helvetica", fontsize="18", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", label="TASK_STATE_AUTH\nREQUIRED"];
    "TLS_HANDSHAKE_INITIATED" [fontname="Helvetica", fontsize="18", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#28a745", label="TLS_HANDSHAKE\nINITIATED"];
    "authenticated" [fontname="Helvetica", fontsize="18", shape="circle", style="dashed", label="authenticated"];
    "TASK_STATE_NONEXISTENT" [fontname="Helvetica", fontsize="18", shape="doublecircle", style="filled,dashed", fillcolor="#d4edda", color="#6c757d", penwidth="2.0", label="TASK_STATE\nNONEXISTENT\n[boundary]"];

    // Transitions
    "TLS_HANDSHAKE_INITIATED" -> "SERVER_IDENTITY_VERIFIED" [label="tls_certificate_validated\n[client.server_identity_verified = true]", style="dashed", color="#fd7e14", fontcolor="#fd7e14", penwidth="1.0"];
    "SERVER_IDENTITY_VERIFIED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="auth_requirements_discovered", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "CLIENT_CREDENTIAL_ACQUISITION" -> "CLIENT_CREDENTIAL_TRANSMISSION" [label="credentials_acquired\n[client.credentials_acquired = true]", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "CLIENT_CREDENTIAL_TRANSMISSION" -> "SERVER_VALIDATING_REQUEST" [label="request_received", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "CLIENT_CREDENTIAL_TRANSMISSION" -> "SERVER_VALIDATING_REQUEST" [label="get_extended_agent_card_request\n[request.auth_scheme matches agent_card.securitySchemes]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "SERVER_VALIDATING_REQUEST" -> "authenticated" [label="credentials_validated\n[request.authenticated = true]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "SERVER_VALIDATING_REQUEST" -> "AUTHENTICATION_FAILED" [label="authentication_challenge_or_rejection\n[request.credentials.valid = false | request.credentials\n= null]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "SERVER_VALIDATING_REQUEST" -> "AUTHENTICATION_FAILED" [label="authentication_error", style="dashed", color="#fd7e14", fontcolor="#fd7e14", penwidth="1.0"];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="request_received\n[client.permissions.sufficient = true]", style="dashed", color="#28a745", fontcolor="#28a745", penwidth="1.0"];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="A2A_protocol_operations_request\n[caller.authenticated = true]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "authenticated" -> "REQUEST_AUTHORIZED" [label="get_extended_agent_card_request\n[client.authenticated = true]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "authenticated" -> "AUTHORIZATION_DENIED" [label="request_received\n[client.authenticated = true &\nclient.permissions.sufficient = false]", style="dashed", color="#dc3545", fontcolor="#dc3545", penwidth="1.0"];
    "AUTHENTICATION_FAILED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="authentication_retry\n[response.authentication_challenge_info = present]", style="dashed", color="#28a745", fontcolor="#28a745", penwidth="1.0"];
    "TASK_STATE_AUTH_REQUIRED" -> "CLIENT_CREDENTIAL_ACQUISITION" [label="secondary_credentials_requested", style="dashed", color="#666666", fontcolor="#666666", penwidth="1.0"];
    "CLIENT_CREDENTIAL_ACQUISITION" -> "TLS_HANDSHAKE_INITIATED" [label="transport_security_initiated\n[client.required_auth_scheme != null]", style="dashed", color="#9333ea", fontcolor="#9333ea", penwidth="2.2"];
    "REQUEST_AUTHORIZED" -> "TASK_STATE_NONEXISTENT" [label="initial_message_authorized\n[client.permissions.sufficient = true]", style="dashed", color="#9333ea", fontcolor="#9333ea", penwidth="2.2"];

}